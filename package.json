{
	"name": "playfulprogramming-site",
	"private": true,
	"description": "Learning programming from magically majestic words",
	"version": "0.3.0-alpha.1",
	"bugs": {
		"url": "https://github.com/playfulprogramming/playfulprogramming/issues"
	},
	"homepage": "https://playfulprogramming.com",
	"browserslist": "baseline widely available",
	"keywords": [
		"blog",
		"education",
		"programming"
	],
	"type": "module",
	"license": "MPL-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/playfulprogramming/playfulprogramming.git"
	},
	"packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
	"engines": {
		"node": "24.x || 26.x"
	},
	"imports": {
		"#components/*": "./src/components/*",
		"#src/*": "./src/*",
		"#types/*": "./src/types/*",
		"#utils/*": "./src/utils/*"
	},
	"scripts": {
		"debug": "NODE_OPTIONS='--inspect-brk' astro dev --verbose",
		"dev": "astro dev",
		"dev:local": "astro dev --mode localhost",
		"storybook": "storybook dev -p 6006",
		"start": "pnpm dev",
		"build": "astro build",
		"build:debug": "astro build --mode debug",
		"build:local": "astro build --mode localhost",
		"build:storybook": "storybook build",
		"preview": "astro preview",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy url globalVariable baseLocale",
		"format": "prettier -w . --cache --plugin-search-dir=.",
		"prelint": "pnpm run paraglide:compile",
		"lint": "eslint \"**/*.{js,ts,tsx,jsx,astro}\" && pnpm run lint:css",
		"lint:css": "stylelint \"src/**/*.{scss,astro,css}\"",
		"prelint:fix": "pnpm run paraglide:compile",
		"lint:fix": "eslint --cache --fix \"**/*.{js,ts,tsx,jsx,astro}\" && stylelint --fix \"src/**/*.{scss,astro,css}\"",
		"preknip": "pnpm run paraglide:compile",
		"knip": "knip",
		"presearch-index:deploy": "pnpm run paraglide:compile",
		"search-index:deploy": "node --env-file-if-exists=.env --experimental-strip-types scripts/deploy-search-index.ts",
		"hoof:generate": "openapi-typescript 'https://hoof.playfulprogramming.com/docs/openapi.json' -o src/utils/hoof/schema.d.ts",
		"pretsc": "pnpm run paraglide:compile",
		"tsc": "astro check && tsc --noEmit --project tsconfig.tsc.json",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"pretest:unit": "pnpm run paraglide:compile",
		"test:unit": "vitest",
		"pretest:unit:node": "pnpm run paraglide:compile",
		"test:unit:node": "vitest --project node",
		"pretest:unit:ui": "pnpm run paraglide:compile",
		"test:unit:ui": "vitest --project ui",
		"test:e2e": "pnpm --filter e2e test",
		"test:e2e:update-snapshots": "pnpm --filter e2e test:update-snapshots",
		"test:e2e:update": "pnpm --filter e2e test:update-snapshots",
		"pretest:debug": "pnpm run paraglide:compile",
		"test:debug": "set DEBUG_PRINT_LIMIT=9999999999 && pnpm vitest",
		"pretest:stress": "pnpm run paraglide:compile",
		"test:stress": "./scripts/run-tests-concurrently.sh --run",
		"prepare": "husky"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/node": "^11.1.4",
		"@astrojs/preact": "^6.0.4",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.25.0",
		"@lesjoursfr/html-to-epub": "^6.2.0",
		"@octokit/graphql": "^9.0.4",
		"@preact/preset-vite": "^2.10.6",
		"@react-types/shared": "^3.36.1",
		"@shikijs/rehype": "^4.4.3",
		"@shikijs/themes": "^4.4.3",
		"@shikijs/transformers": "^4.4.3",
		"@storybook-astro/framework": "1.11.0",
		"@storybook/addon-a11y": "10.5.10",
		"@storybook/builder-vite": "10.5.10",
		"@storybook/preact": "10.5.10",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/preact": "^3.2.3",
		"@testing-library/user-event": "^14.6.6",
		"@types/git-branch": "^2.0.5",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.3",
		"@types/node": "25.9.1",
		"@types/tiny-async-pool": "^2.0.3",
		"@types/unist": "^3.0.3",
		"@vitest/browser-playwright": "^5.0.0",
		"astro": "^7.2.9",
		"astro-eslint-parser": "^3.1.0",
		"astro-icon": "^1.2.0",
		"browserslist": "^4.28.8",
		"classnames": "^2.3.2",
		"emoji-regex": "^10.6.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.9.1",
		"eslint-config-preact": "^2.0.0",
		"eslint-plugin-astro": "^3.1.0",
		"eslint-plugin-import": "^2.32.0",
		"feed": "^6.0.0",
		"git-branch": "^2.0.1",
		"globals": "^17.11.0",
		"gray-matter": "^4.0.3",
		"hast-util-from-html": "^2.0.3",
		"hast-util-has-property": "^3.0.0",
		"hast-util-heading-rank": "^3.0.0",
		"hast-util-to-html": "^9.0.5",
		"hast-util-to-string": "^3.0.1",
		"hastscript": "^9.0.1",
		"husky": "^9.1.7",
		"json5": "^2.2.3",
		"junk": "^4.0.1",
		"katex": "^0.18.4",
		"kleur": "^4.1.5",
		"knip": "^6.33.0",
		"lightningcss": "^1.33.0",
		"lint-staged": "^17.4.1",
		"msw": "^2.15.0",
		"octokit": "^5.0.5",
		"openapi-typescript": "^7.13.0",
		"playwright": "1.62.1",
		"postcss-html": "^2.0.0",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"react": "npm:@preact/compat@18.3.1",
		"react-dom": "npm:@preact/compat@18.3.1",
		"rehype-katex": "^7.0.1",
		"rehype-parse": "9.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-slug-custom-id": "^2.0.0",
		"rehype-stringify": "^10.0.1",
		"rehype-unwrap-images": "^1.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"sass": "^1.103.1",
		"sharp": "^0.35.4",
		"shiki": "^4.4.3",
		"sitemap": "^9.0.1",
		"storybook": "10.5.10",
		"stylelint": "^17.14.1",
		"stylelint-config-recommended-scss": "^17.0.1",
		"stylelint-value-no-unknown-custom-properties": "^6.1.1",
		"symlink-dir": "^10.0.1",
		"terser": "^5.51.2",
		"tiny-async-pool": "^2.1.0",
		"tinypool": "^2.1.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"unified": "^11.0.5",
		"unist-util-find": "^3.0.0",
		"unist-util-is": "^6.0.1",
		"unist-util-visit": "^5.1.0",
		"vfile": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"lint-staged": {
		"*.{js,ts,tsx,astro}": "eslint --cache --fix",
		"*.{js,ts,tsx,astro,jsx}": "prettier --write",
		"*.{scss,astro,css}": "stylelint"
	},
	"dependencies": {
		"@babel/runtime": "^8.0.0",
		"@internationalized/date": "^3.12.3",
		"@nanostores/preact": "^1.1.0",
		"@plausible-analytics/tracker": "^0.4.6",
		"@preact/signals": "^2.11.1",
		"@react-aria/utils": "^3.34.1",
		"@tanstack/react-query": "^5.102.8",
		"@webcontainer/api": "^1.6.4",
		"fflate": "^0.8.3",
		"medium-zoom": "^1.0.8",
		"mermaid": "^11.17.2",
		"nanostores": "^1.5.2",
		"openapi-fetch": "^0.17.0",
		"preact": "10.29.8",
		"react-aria": "^3.51.0",
		"react-aria-components": "^1.20.0",
		"react-stately": "^3.49.0",
		"typesense": "^3.0.6",
		"uuid": "^14.0.2"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
