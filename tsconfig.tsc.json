{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.json",
	"exclude": [
		"dist",
		"storybook-static",
		"content",
		"packages",
		// `astro check` validates these first with Astro's language tooling. Bare
		// `tsc` cannot resolve named type exports from `.astro` modules.
		"**/*.stories.ts",
		"**/*.stories.tsx"
	]
}
