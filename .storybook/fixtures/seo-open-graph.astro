---
import Component from "#components/seo/open-graph.astro";
import type { ComponentProps } from "astro/types";
export type Props = ComponentProps<typeof Component>;
---

<section data-seo-story>
	<h2>OpenGraph metadata</h2>
	<p>These are the tags emitted by the component for the example page.</p>
	<div data-seo-tags><Component {...Astro.props} /></div>
	<pre data-seo-output></pre>
</section>
