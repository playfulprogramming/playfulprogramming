{
    "$schema": "../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "e2e",
    "projectType": "application",
    "targets": {
        "test:build": {
            "command": "docker compose -f e2e/docker-compose.e2e.yml build"
        },
        "test:e2e:update-snapshots": {
            "dependsOn": ["test:build"],
            "executor": "nx:run-commands",
            "options": {
                "command": "docker compose -f e2e/docker-compose.e2e.yml up --abort-on-container-exit --exit-code-from e2e",
                "env": {
                    "PLAYWRIGHT_ARGS": "--update-snapshots"
                }
            }
        },
        "test": {
            "dependsOn": ["test:build"],
            "command": "docker compose -f e2e/docker-compose.e2e.yml up --abort-on-container-exit --exit-code-from e2e"
        },
        "test:e2e:interactive:start": {
            "dependsOn": ["test:build"],
            "command": "docker compose -f e2e/docker-compose.e2e.yml up fakeserver web --build --wait"
        },
        "test:e2e:interactive": {
            "dependsOn": ["test:build", "test:e2e:interactive:start"],
            "command": "playwright test --config e2e/playwright.config.ts --ui",
            "continuous": true
        }
    },
    "implicitDependencies": ["playfulprogramming-site"]
}