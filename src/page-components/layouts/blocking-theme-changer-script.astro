---
import * as Terser from "terser";

import {
	BRAND_THEME_STORAGE_KEY,
	COLOR_MODE_STORAGE_KEY,
	THEME_COLOR_DARK,
	THEME_COLOR_LIGHT,
} from "../../constants/theme.ts";
import { serializeInlineCall } from "#utils/serialize-inline-call.ts";
import {
	ALLOWED_THEME_FONT_FAMILIES,
	BRAND_THEME_PROPERTIES,
	COLOR_SCHEME_MEDIA_QUERY,
} from "#utils/theming.ts";

/**
 * Much of this code deals with dark mode. It's ripped straight from:
 * @see https://joshwcomeau.com/gatsby/dark-mode/
 *
 * Huge thanks to Josh for outlining how to do this
 */
/**
 * DARK MODE CODE
 *
 * Prevents the "flash" of light mode
 */
const setColorsByTheme = serializeInlineCall(
	({
		storageKey,
		lightTheme,
		darkTheme,
		colorSchemeMediaQuery,
	}: {
		storageKey: string;
		lightTheme: string;
		darkTheme: string;
		colorSchemeMediaQuery: string;
	}): void => {
		let savedPreference: string | null = null;
		try {
			savedPreference = localStorage.getItem(storageKey);
		} catch {
			// Storage can be unavailable. Fall back to the system preference.
		}

		const preference =
			savedPreference === "light" || savedPreference === "dark"
				? savedPreference
				: "system";
		let prefersDark = false;
		try {
			prefersDark = window.matchMedia(colorSchemeMediaQuery).matches;
		} catch {
			// Browsers without matchMedia fall back to light mode.
		}

		const colorMode =
			preference === "system" ? (prefersDark ? "dark" : "light") : preference;
		const root = document.documentElement;
		root.classList.toggle("light", colorMode === "light");
		root.classList.toggle("dark", colorMode === "dark");

		// update the meta theme-color attribute(s) based on the user preference
		const bgColor = colorMode === "light" ? lightTheme : darkTheme;
		// this needs to update both meta tags so that it applies regardless of prefers-color-scheme
		document
			.querySelectorAll("meta[name='theme-color']")
			.forEach((el) => el.setAttribute("content", bgColor));
	},
);

const setBrandColorsByTheme = serializeInlineCall(
	({
		storageKey,
		properties,
		fontFamilies,
	}: {
		storageKey: string;
		properties: readonly string[];
		fontFamilies: readonly string[];
	}): void => {
		try {
			const savedTheme = localStorage.getItem(storageKey);
			if (!savedTheme) return;

			const theme: unknown = JSON.parse(savedTheme);
			if (!theme || typeof theme !== "object" || Array.isArray(theme)) return;

			const root = document.documentElement;
			const allowedProperties = new Set(properties);
			const hueProperties = new Set([
				"--hue-primary",
				"--hue-secondary",
				"--hue-positive",
				"--hue-error",
			]);
			const fontProperties = new Set([
				"--pfp-font-family-brand",
				"--pfp-font-family-body",
			]);
			const allowedFontFamilies = new Set(fontFamilies);
			const numberPattern = /^-?(?:\d+(?:\.\d*)?|\.\d+)$/;

			Object.entries(theme).forEach(([storedProperty, storedValue]) => {
				const property = storedProperty.startsWith("--")
					? storedProperty
					: `--${storedProperty}`;
				if (
					!allowedProperties.has(property) ||
					typeof storedValue !== "string"
				) {
					return;
				}

				const value = storedValue.trim();
				let isValid = value === "";
				if (fontProperties.has(property)) {
					isValid ||= allowedFontFamilies.has(value);
				} else if (numberPattern.test(value)) {
					const number = Number(value);
					isValid ||=
						Number.isFinite(number) &&
						(hueProperties.has(property)
							? number >= 0 && number <= 360
							: property === "--chroma-factor" && number >= 0 && number <= 2);
				}

				if (!isValid) return;
				if (value) root.style.setProperty(property, value);
				else root.style.removeProperty(property);
			});
		} catch {
			// Ignore malformed saved theme values.
		}
	},
);

const inlineScript = [
	setColorsByTheme({
		storageKey: COLOR_MODE_STORAGE_KEY,
		lightTheme: THEME_COLOR_LIGHT,
		darkTheme: THEME_COLOR_DARK,
		colorSchemeMediaQuery: COLOR_SCHEME_MEDIA_QUERY,
	}),
	setBrandColorsByTheme({
		storageKey: BRAND_THEME_STORAGE_KEY,
		properties: BRAND_THEME_PROPERTIES,
		fontFamilies: ALLOWED_THEME_FONT_FAMILIES,
	}),
].join("");

const calledFunction = (await Terser.minify(inlineScript)).code!;
---

<script is:inline set:html={calledFunction} />
