---
import Barebones from "#components/layouts/barebones/barebones.astro";
import { baseLocale } from "#src/paraglide/runtime.js";

import "#src/views/collection-framework-field-guide/styles/fonts/plus-jakarta-sans.css";
import "#src/views/collection-framework-field-guide/styles/fonts/changa-one.css";
import "#src/views/collection-framework-field-guide/styles/tokens/adventure.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/buttons.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/colors.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/book-sections.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/dimensions.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/text-styles.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/themes.scss";
import "#src/views/collection-framework-field-guide/styles/global-ffg.css";
import "#src/views/collection-framework-field-guide/styles/buttons.css";
import "#src/views/collection-framework-field-guide/styles/focus.css";
import "#src/views/collection-framework-field-guide/styles/svg-layers.css";
import "#src/views/collection-framework-field-guide/styles/tokens/forms.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/sign-up.scss";

import SEO from "#src/components/seo/seo.astro";
import Header from "#src/views/collection-framework-field-guide/components/header.astro";
import Hero from "#src/views/collection-framework-field-guide-fundamentals/segments/hero-fundamentals.astro";
import Fundamentals from "#src/views/collection-framework-field-guide-fundamentals/segments/fundamentals-fundamentals.astro";
import Ecosystem from "#src/views/collection-framework-field-guide-fundamentals/segments/ecosystem-fundamentals.astro";
import { getCollectionBySlug, getPersonById } from "#utils/api.ts";

const collection = getCollectionBySlug(
	"framework-field-guide-fundamentals",
	baseLocale,
)!;
---

<Barebones>
	<SEO
		slot="head"
		title={collection.title}
		description={collection.description}
		peopleData={[getPersonById("crutchcorn", baseLocale)!]}
		publishedTime={collection.published}
		type={"book"}
		shareImage={collection.socialImgMeta?.relativeServerPath}
	/>
	<Header />
	<main>
		<Hero />
		<Fundamentals />
		<Ecosystem />
	</main>
</Barebones>
<script>
	import { enableSmoothScrollForAnchorsToCurrentPage } from "#utils/smooth-scroll-for-anchors-to-current-page.ts";
	enableSmoothScrollForAnchorsToCurrentPage();
</script>
<script>
	import { enableColorChangeListeners } from "#src/views/collection-framework-field-guide/utils/color-change-listener.ts";
	enableColorChangeListeners();
</script>
<script>
	import { enableParallaxScrolling } from "#src/views/collection-framework-field-guide/utils/parallax-scrolling.ts";
	enableParallaxScrolling();
</script>
