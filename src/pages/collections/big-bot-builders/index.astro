---
import Barebones from "#components/layouts/barebones/barebones.astro";
import { baseLocale } from "#src/paraglide/runtime.js";

// Stylesheets must be imported before any component, so that component styles
// are ordered after them in the bundled build
import "#src/views/collection-framework-field-guide/styles/fonts/plus-jakarta-sans.css";
import "#src/views/collection-framework-field-guide/styles/fonts/changa-one.css";
import "#src/views/collection-framework-field-guide/styles/tokens/buttons.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/book-sections.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/dimensions.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/text-styles.scss";
import "#src/views/collection-framework-field-guide/styles/buttons.css";
import "#src/views/collection-framework-field-guide/styles/focus.css";
import "#src/views/collection-framework-field-guide/styles/svg-layers.css";
import "#src/views/collection-framework-field-guide/styles/tokens/forms.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/sign-up.scss";
import "#src/views/collection-big-bot-builders/tokens/colors.scss";
import "#src/views/collection-big-bot-builders/styles/global-bbb.css";

import SEO from "#src/components/seo/seo.astro";
import Header from "#src/views/collection-framework-field-guide/components/header.astro";
import Hero from "#src/views/collection-big-bot-builders/segments/hero.astro";
import {
	getPersonById,
	getCollectionBySlug,
	getPostsByCollection,
} from "#utils/api.ts";

import Rest from "#src/views/collection-big-bot-builders/segments/rest.astro";
import TopContents from "#src/views/collection-big-bot-builders/segments/top-contents.astro";
import BottomContents from "#src/views/collection-big-bot-builders/segments/bottom-contents.astro";
import CollectionTableOfContents from "#src/views/collection-framework-field-guide-fundamentals/components/table-of-contents/collection-table-of-contents-fundamentals.astro";

const collection = getCollectionBySlug("big-bot-builders", baseLocale);
const chapterList = getPostsByCollection("big-bot-builders", baseLocale);
const comingSoon = [
	{ order: 1, title: "AI Basics", description: "Coming soon..." },
	{ order: 2, title: "AI Products", description: "Coming soon..." },
	{ order: 3, title: "AI Usage", description: "Coming soon..." },
	{ order: 4, title: "Components of an LLM", description: "Coming soon..." },
	{ order: 5, title: "How Models Learn", description: "Coming soon..." },
	{ order: 6, title: "Coding with LLMs", description: "Coming soon..." },
	{
		order: 7,
		title: "Inside a Transformer Layer",
		description: "Coming soon...",
	},
	{
		order: 8,
		title: "Producing the Next Token",
		description: "Coming soon...",
	},
	{ order: 9, title: "Fine-tuning and RLHF", description: "Coming soon..." },
];
---

<Barebones>
	<SEO
		slot="head"
		title={"The Big Bot Builders"}
		description={"A beginner-to-advanced series on how modern AI models are trained, generate responses, use tools, and remember information."}
		peopleData={[getPersonById("crutchcorn", baseLocale)!]}
		type={"book"}
		shareImage={collection?.socialImgMeta?.relativeServerPath}
	/>
	<Header />
	<main>
		<Hero />
		<Rest>
			<TopContents />
			<CollectionTableOfContents
				title="Outline*"
				chaptersToShow={5}
				chapterList={comingSoon}
				posts={chapterList}
				postPrefixToRemove="The Big Bot Builders: "
			/>
			<BottomContents />
		</Rest>
	</main>
</Barebones>
<script>
	import { enableSmoothScrollForAnchorsToCurrentPage } from "#utils/smooth-scroll-for-anchors-to-current-page.ts";
	enableSmoothScrollForAnchorsToCurrentPage();
</script>
<script>
	import { enableParallaxScrolling } from "#src/views/collection-framework-field-guide/utils/parallax-scrolling.ts";
	enableParallaxScrolling();
</script>
