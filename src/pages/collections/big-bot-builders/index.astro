---
import Barebones from "#src/layouts/barebones.astro";

import SEO from "#src/components/seo/seo.astro";
import Header from "#src/views/collections/framework-field-guide/segments/header.astro";
import Hero from "../../../views/collections/big-bot-builders/segments/hero.astro";
import {
	getPersonById,
	getCollectionBySlug,
	getPostsByCollection,
} from "#utils/api.ts";

import "../../../views/collections/framework-field-guide/fonts/plus-jakarta-sans.css";
import "../../../views/collections/framework-field-guide/fonts/changa-one.css";
import "../../../views/collections/framework-field-guide/tokens/buttons.scss";
import "../../../views/collections/framework-field-guide/tokens/book-sections.scss";
import "../../../views/collections/framework-field-guide/tokens/dimensions.scss";
import "../../../views/collections/framework-field-guide/tokens/text-styles.scss";
import "../../../views/collections/framework-field-guide/styles/buttons.css";
import "../../../views/collections/framework-field-guide/styles/focus.css";
import "../../../views/collections/framework-field-guide/styles/svg-layers.css";
import "../../../views/collections/framework-field-guide/tokens/forms.scss";
import "../../../views/collections/framework-field-guide/tokens/sign-up.scss";

import "../../../views/collections/big-bot-builders/tokens/colors.scss";
import "../../../views/collections/big-bot-builders/styles/global-bbb.css";
import Rest from "../../../views/collections/big-bot-builders/segments/rest.astro";
import TopContents from "../../../views/collections/big-bot-builders/segments/top-contents.astro";
import BottomContents from "../../../views/collections/big-bot-builders/segments/bottom-contents.astro";
import CollectionTableOfContents from "../../../views/collections/framework-field-guide-fundamentals/components/collection-table-of-contents-fundamentals.astro";

const collection = getCollectionBySlug("big-bot-builders", "en");
const chapterList = getPostsByCollection("big-bot-builders", "en");
const comingSoon = [
	{order: 1, title: "AI Basics", description: "Coming soon..."},
	{order: 2, title: "AI Products", description: "Coming soon..."},
	{order: 3, title: "AI Usage", description: "Coming soon..."},
	{order: 4, title: "Components of an LLM", description: "Coming soon..."},
	{order: 5, title: "How Models Learn", description: "Coming soon..."},
	{order: 6, title: "Coding with LLMs", description: "Coming soon..."},
	{order: 7, title: "Inside a Transformer Layer", description: "Coming soon..."},
	{order: 8, title: "Producing the Next Token", description: "Coming soon..."},
	{order: 9, title: "Fine-tuning and RLHF", description: "Coming soon..."},
];
---

<Barebones>
	<SEO
		slot="head"
		title={"The Big Bot Builders"}
		description={"A beginner-to-advanced series on how modern AI models are trained, generate responses, use tools, and remember information."}
		peopleData={[getPersonById("crutchcorn", "en")!]}
		publishedTime={"2027-01-01T13:45:00.284Z"}
		type={"book"}
		shareImage={collection?.socialImgMeta?.relativeServerPath}
	/>
	<Header />
	<main>
		<Hero />
		<Rest>
			<TopContents />
			<CollectionTableOfContents
				title="Sections*"
				chaptersToShow={5}
				chapterList={comingSoon}
				posts={chapterList}
				postPrefixToRemove="The Big Bot Builders: "
			/>
			<BottomContents />
		</Rest>
	</main>
</Barebones>
<script>
	import { enableSmoothScrollForAnchorsToCurrentPage } from "#utils/smooth-scroll-for-anchors-to-current-page.ts";
	enableSmoothScrollForAnchorsToCurrentPage();
</script>
<script>
	import { enableParallaxScrolling } from "../../../views/collections/framework-field-guide/scripts/parallax-scrolling.ts";
	enableParallaxScrolling();
</script>
