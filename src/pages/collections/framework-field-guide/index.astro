---
import Barebones from "#components/layouts/barebones/barebones.astro";
import { baseLocale } from "#src/paraglide/runtime.js";
import "#src/views/collection-framework-field-guide/styles/fonts/fira-code.css";
import "#src/views/collection-framework-field-guide/styles/fonts/plus-jakarta-sans.css";
import "#src/views/collection-framework-field-guide/styles/fonts/changa-one.css";
import "#src/views/collection-framework-field-guide/styles/fonts/playpen-sans.css";
import "#src/views/collection-framework-field-guide/styles/tokens/dimensions.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/colors.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/text-styles.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/themes.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/adventure.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/buttons.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/code-block.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/book-sections.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/transition-timer.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/quotes.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/sign-up.scss";
import "#src/views/collection-framework-field-guide/styles/tokens/forms.scss";
import "#src/views/collection-framework-field-guide/styles/global-ffg.css";
import "#src/views/collection-framework-field-guide/styles/buttons.css";
import "#src/views/collection-framework-field-guide/styles/focus.css";
import "#src/views/collection-framework-field-guide/styles/svg-layers.css";
import "#src/views/collection-framework-field-guide/styles/shiki.scss";
import SEO from "#src/components/seo/seo.astro";
import Header from "#src/views/collection-framework-field-guide/components/header.astro";
import Hero from "#src/views/collection-framework-field-guide/components/hero/hero.astro";
import Fundamentals from "#src/views/collection-framework-field-guide/components/fundamentals.astro";
import Ecosystem from "#src/views/collection-framework-field-guide/components/ecosystem.astro";
import Internals from "#src/views/collection-framework-field-guide/components/internals.astro";
import Quotes from "#src/views/collection-framework-field-guide/components/quotes/quotes.astro";
import AdventureContinues from "#src/views/collection-framework-field-guide/components/adventure-continues/adventure-continues.astro";
import YourGuide from "#src/views/collection-framework-field-guide/components/your-guide/your-guide.astro";
import CodeBlock from "#src/views/collection-framework-field-guide/components/code-block/code-block.astro";
import TheRestContainer from "#src/views/collection-framework-field-guide/components/the-rest-container/the-rest-container.astro";
import SignUp from "#src/views/collection-framework-field-guide/components/sign-up/sign-up.astro";
import WhyLearnAllThree from "#src/views/collection-framework-field-guide/components/why-learn-all-three/why-learn-all-three.astro";
import WhatDoIGet from "#src/views/collection-framework-field-guide/components/what-do-i-get/what-do-i-get.astro";
import { getCollectionBySlug, getPersonById } from "#utils/api.ts";
import BlockingTabsSignalScript from "#components/tabs/blocking-tabs-signal-script.astro";

const collection = getCollectionBySlug("framework-field-guide", baseLocale)!;
---

<Barebones>
	<SEO
		slot="head"
		title={collection.title}
		description={collection.description}
		peopleData={[getPersonById("crutchcorn", baseLocale)!]}
		publishedTime={collection.published}
		type={"book"}
		shareImage={collection.socialImgMeta?.relativeServerPath}
	/>
	<Header />
	<main>
		<Hero />
		<Fundamentals />
		<Ecosystem />
		<Internals />
		<TheRestContainer>
			<WhyLearnAllThree />
			<WhatDoIGet />
			<CodeBlock />
			<YourGuide />
			<Quotes />
			<AdventureContinues />
			<SignUp />
		</TheRestContainer>
	</main>
</Barebones>
<script>
	import { enableSmoothScrollForAnchorsToCurrentPage } from "#utils/smooth-scroll-for-anchors-to-current-page.ts";
	enableSmoothScrollForAnchorsToCurrentPage();
</script>
<script>
	import { enableColorChangeListeners } from "#src/views/collection-framework-field-guide/utils/color-change-listener.ts";
	enableColorChangeListeners();
</script>
<script>
	import { enableParallaxScrolling } from "#src/views/collection-framework-field-guide/utils/parallax-scrolling.ts";
	enableParallaxScrolling();
</script>
<BlockingTabsSignalScript />
