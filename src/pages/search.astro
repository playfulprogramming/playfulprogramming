---
import style from "../views/search/search-page.module.scss";
import SearchPage from "../views/search/search-page.tsx";
import Document from "../layouts/document.astro";
import SEO from "../components/seo/seo.astro";
import { siteMetadata } from "#src/constants/site-config.ts";
import { m } from "#src/paraglide/messages.js";
import type { Locale } from "#src/paraglide/runtime.js";

const locale: Locale = "en";
---

<Document lang={locale} size="xl">
	<SEO title={m.title_search()} description={m.desc_search()} slot="head" />
	<main>
		<h1 class="visually-hidden">{m.title_search()}</h1>
		<noscript>
			<p class={`text-style-headline-3 ${style.centerHeader}`}>
				{m.search_noscript()}
			</p>
		</noscript>
		<SearchPage
			client:only="preact"
			siteTitle={siteMetadata.title}
			locale={locale}
		/>
	</main>
</Document>
