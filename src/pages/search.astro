---
import style from "../views/search/search-page.module.scss";
import SearchPage from "../views/search/search-page.tsx";
import Document from "../layouts/document.astro";
import SEO from "../components/seo/seo.astro";
import { siteMetadata } from "#src/constants/site-config.ts";
import { translate } from "#utils/translations.ts";
---

<Document lang={"en"} size="xl">
	<SEO
		title="Search"
		description="Find your favorite articles and collections on Playful Programming easier than ever!"
		slot="head"
	/>
	<main>
		<h1 class="visually-hidden">Search</h1>
		<noscript>
			<p class={`text-style-headline-3 ${style.centerHeader}`}>
				JavaScript needs to be enabled to use this page
			</p>
		</noscript>
		<SearchPage
			client:only="preact"
			siteTitle={siteMetadata.title}
			postCardI18n={{
				authorsLabel: translate(Astro, "label.post_authors"),
				tagsLabel: translate(Astro, "label.post_tags"),
				wordCountLabel: translate(Astro, "title.n_words"),
			}}
			collectionCardI18n={{
				authorsLabel: translate(Astro, "label.collection_authors"),
				chapterCountLabel: translate(Astro, "title.n_chapters"),
			}}
		/>
	</main>
</Document>
