---
import style from "../views/search/search-page.module.scss";
import SearchPage from "../views/search/search-page.tsx";
import Document from "../layouts/document.astro";
import SEO from "../components/seo/seo.astro";
import { siteMetadata } from "#src/constants/site-config.ts";
import { getPrefixLanguageFromPath, translate } from "#utils/translations.ts";

const locale = getPrefixLanguageFromPath(Astro.url.pathname);
---

<Document size="xl">
	<SEO
		title={translate(Astro, "title.search")}
		description={translate(Astro, "desc.search")}
		slot="head"
	/>
	<main>
		<h1 class="visually-hidden">{translate(Astro, "title.search")}</h1>
		<noscript>
			<p class={`text-style-headline-3 ${style.centerHeader}`}>
				{translate(Astro, "search.noscript")}
			</p>
		</noscript>
		<SearchPage
			client:only="preact"
			siteTitle={siteMetadata.title}
			locale={locale}
		/>
	</main>
</Document>
