---
import Document from "#src/layouts/document.astro";
import { getCollectionsByLang, getPostsByLang } from "#utils/api.ts";
import SEO from "#components/seo/seo.astro";
import Homepage from "#src/views/explore/homepage.astro";
import NotFoundPage from "#src/views/not-found/not-found-page.astro";
import {
	getStaticLocalePaths,
	isValidLocaleRouteParam,
} from "#utils/locales.ts";
import { getLocale } from "#src/paraglide/runtime.js";
import { m } from "#src/paraglide/messages.js";

export function getStaticPaths() {
	return getStaticLocalePaths();
}

const localeParam = Astro.params.locale;
const isLocaleRoute = isValidLocaleRouteParam(localeParam);
if (!isLocaleRoute) {
	Astro.response.status = 404;
}

const locale = getLocale();
const providedLangs = getStaticLocalePaths().map(({ props }) => props.locale);

const posts = isLocaleRoute ? getPostsByLang(locale) : [];
const postsToDisplay = posts.slice(0, 4);

const collectionsToDisplay = isLocaleRoute
	? getCollectionsByLang(locale).slice(0, 4)
	: [];
---

{
	isLocaleRoute ? (
		<Document>
			<SEO slot="head" title={m.title_home()} providedLangs={providedLangs} />
			<main class="container">
				<Homepage posts={postsToDisplay} collections={collectionsToDisplay} />
			</main>
		</Document>
	) : (
		<NotFoundPage />
	)
}
