---
import Document from "#components/layouts/document/document.astro";
import { getHomepageCollections, getHomepagePosts } from "#utils/api.ts";
import SEO from "#components/seo/seo.astro";
import Homepage from "#src/views/homepage/homepage.astro";
import {
	getStaticLocalePaths,
	isValidLocaleRouteParam,
} from "#utils/locales.ts";
import { getLocale, localizeHref } from "#src/paraglide/runtime.js";
import { m } from "#src/paraglide/messages.js";

export function getStaticPaths() {
	return getStaticLocalePaths();
}

const localeParam = Astro.params.locale;
if (!isValidLocaleRouteParam(localeParam)) {
	return Astro.rewrite(localizeHref("/404"));
}

const locale = getLocale();
const providedLangs = getStaticLocalePaths().map(({ props }) => props.locale);

const posts = await getHomepagePosts(locale);
const collections = await getHomepageCollections(locale);
---

<Document>
	<SEO slot="head" title={m.title_home()} providedLangs={providedLangs} />
	<main class="container">
		<Homepage posts={posts} collections={collections} />
	</main>
</Document>
