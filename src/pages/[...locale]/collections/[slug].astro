---
import SEO from "#src/components/seo/seo.astro";
import Document from "#components/layouts/document/document.astro";
import * as api from "#utils/api.ts";
import CollectionPage from "#src/views/collections/collection-page.astro";
import CollectionChapter from "#src/views/collections/components/collection-chapter/collection-chapter.astro";
import { SubHeader } from "#src/components/subheader/subheader.tsx";
import { isValidLocaleRouteParam } from "#utils/locales.ts";
import type { CurrentPost, FuturePost } from "#types/index.ts";
import { getMarkdownHtml } from "#utils/markdown/index.ts";
import { baseLocale, getLocale, localizeHref } from "#src/paraglide/runtime.js";
import { m } from "#src/paraglide/messages.js";

export async function getStaticPaths() {
	const collections = api.getAllCollections();

	return collections
		.filter((collection) => collection.pageLayout !== "none")
		.map((collection) => {
			return {
				params: {
					locale:
						collection.locale !== baseLocale ? collection.locale : undefined,
					slug: collection.slug,
				},
				props: {},
			};
		});
}

const params = Astro.params as {
	locale?: string;
	slug: string;
};

if (!isValidLocaleRouteParam(params.locale)) {
	return Astro.rewrite("/404");
}

const locale = getLocale();
const collection = api.getCollectionBySlug(params.slug, locale)!;
const collectionPosts = api.getPostsByCollection(params.slug, locale);
const authors = collection.authors.map(
	(authorId) => api.getPersonById(authorId, locale)!,
);

const collectionHtml = await getMarkdownHtml(collection);

const isCurrentPost = (
	chapter: CurrentPost | FuturePost,
): chapter is CurrentPost => {
	return (chapter as CurrentPost).post !== undefined;
};

let collectionData: Array<Parameters<typeof CollectionChapter>[0]> = [];

if (collection?.chapterList?.length) {
	collectionData = collection?.chapterList.map((post, i) => {
		let title: string;
		let href: string | undefined;
		let description: string;
		let externalLink = false;
		if (isCurrentPost(post)) {
			const postData = api.getPostBySlug(post.post, locale);
			title = postData?.title || m.fallback_no_title();
			description = postData?.description || m.fallback_no_description();
			href = post?.post
				? localizeHref(`/posts/${post.post}`, {
						locale: postData?.locale ?? locale,
					})
				: undefined;
		} else {
			title = post.title;
			description = post.description || "";
			externalLink = true;
		}
		return {
			num: i + 1,
			title,
			description,
			href,
			externalLink,
			collection,
		};
	});
} else if (collectionPosts?.length) {
	collectionData = collectionPosts.map(
		({ order, title, description, slug, locale: postLocale }, i) => ({
			num: order || i + 1,
			title,
			description,
			href: localizeHref(`/posts/${slug}`, { locale: postLocale }),
			externalLink: false,
			collection,
		}),
	);
}
---

<Document size="l">
	<SEO
		slot="head"
		title={collection.title}
		description={collection.description}
		peopleData={authors}
		publishedTime={collection.published}
		noindex={collection.noindex}
		type={collection.type}
		shareImage={collection.socialImgMeta?.relativeServerPath ||
			collection.coverImgMeta.relativeServerPath}
		providedLangs={collection.locales}
	/>
	<main>
		<CollectionPage
			collection={collection}
			collectionHtml={collectionHtml}
			authors={authors}
		/>
		<section class="collection-post-list-container">
			<div class="collection-post-list">
				<SubHeader tag="h2" text={m.desc_chapter_listing()} />
				<ol>
					{
						collectionData.map((props) => {
							return (
								<li>
									<CollectionChapter {...props} />
								</li>
							);
						})
					}
				</ol>
			</div>
		</section>
	</main>
</Document>

<style>
	.collection-post-list-container {
		background: var(--tint_primary_none);
	}

	.collection-post-list {
		max-width: var(--max-width_m);
		margin: 0 auto;
		padding: 0 var(--site-spacing) var(--site-spacing);
	}

	.collection-post-list ol {
		list-style: none;
		padding: 0;
		margin: 0;
	}
</style>
