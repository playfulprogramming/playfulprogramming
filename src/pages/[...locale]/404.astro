---
import NotFoundPage from "#src/views/not-found/not-found-page.astro";
import {
	getStaticLocalePaths,
	isNonDefaultLanguageKey,
} from "#utils/translations.ts";

export function getStaticPaths() {
	return getStaticLocalePaths().filter(({ props }) => props.locale !== "en");
}

const localeParam = Astro.params.locale;
if (!isNonDefaultLanguageKey(localeParam)) {
	return Astro.rewrite("/404");
}
---

<NotFoundPage />
