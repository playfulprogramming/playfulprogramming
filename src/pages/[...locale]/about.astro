---
import Document from "#src/layouts/document.astro";
import SEO from "#components/seo/seo.astro";
import AboutView from "#src/views/about/about.astro";
import NotFoundPage from "#src/views/not-found/not-found-page.astro";
import {
	getStaticLocalePaths,
	isValidLocaleRouteParam,
} from "#utils/locales.ts";
import {
	createAboutProps,
	getAboutFiles,
	type AboutPageProps,
} from "#src/views/about/route-data.ts";
import { getLocale } from "#src/paraglide/runtime.js";
import { m } from "#src/paraglide/messages.js";

export async function getStaticPaths() {
	const files = await getAboutFiles();

	return getStaticLocalePaths().map(({ params, props }) => ({
		params,
		props: createAboutProps(files, props.locale),
	}));
}

const localeParam = Astro.params.locale;
const isLocaleRoute = isValidLocaleRouteParam(localeParam);
if (!isLocaleRoute) {
	Astro.response.status = 404;
}

const locale = getLocale();
const generatedProps = Astro.props as Partial<AboutPageProps>;
const hasGeneratedProps =
	typeof generatedProps.file === "string" &&
	typeof generatedProps.isFallback === "boolean" &&
	Array.isArray(generatedProps.locales);
const pageProps = !isLocaleRoute
	? undefined
	: hasGeneratedProps
		? ({ ...generatedProps, locale } as AboutPageProps)
		: createAboutProps(await getAboutFiles(), locale);
---

{
	pageProps ? (
		<Document>
			<SEO
				title={m.title_about_us()}
				description={m.desc_about_us()}
				providedLangs={pageProps.locales}
				noindex={pageProps.isFallback}
				slot="head"
			/>
			<AboutView
				locales={pageProps.locales}
				locale={pageProps.locale}
				file={pageProps.file}
			/>
		</Document>
	) : (
		<NotFoundPage />
	)
}
