---
import * as fs from "fs/promises";
import Document from "#src/layouts/document.astro";
import SEO from "#components/seo/seo.astro";
import AboutView from "#src/views/about/about.astro";
import NotFoundPage from "#src/views/not-found/not-found-page.astro";
import {
	getLanguageFromFilename,
	getStaticLocalePaths,
	isLanguageKey,
	translate,
} from "#utils/translations.ts";
import { join } from "path";
import { contentDirectory } from "#utils/data.ts";
import type { Languages } from "#types/index.ts";

interface Props {
	file: string;
	isFallback: boolean;
	locales: Languages[];
	locale: Languages;
}

async function getAboutFiles() {
	return (await fs.readdir(join(contentDirectory, "site")))
		.filter((filename) => filename.startsWith("about-us"))
		.map((filename) => ({
			file: join(contentDirectory, "site", filename),
			locale: getLanguageFromFilename(filename),
		}));
}

function createAboutProps(
	files: Awaited<ReturnType<typeof getAboutFiles>>,
	locale: Languages,
): Props {
	const englishFile = files.find((file) => file.locale === "en");
	if (!englishFile) {
		throw new Error("Missing English about page content");
	}

	const data = files.find((file) => file.locale === locale) ?? englishFile;

	return {
		file: data.file,
		isFallback: data.locale !== locale,
		locales: files.map((file) => file.locale),
		locale,
	};
}

export async function getStaticPaths() {
	const files = await getAboutFiles();

	return getStaticLocalePaths().map(({ params, props }) => ({
		params,
		props: createAboutProps(files, props.locale),
	}));
}

const localeParam = Astro.params.locale;
const isLocaleRoute = localeParam === undefined || isLanguageKey(localeParam);
if (!isLocaleRoute) {
	Astro.response.status = 404;
}

const locale: Languages = isLanguageKey(localeParam) ? localeParam : "en";
const generatedProps = Astro.props as Partial<Props>;
const hasGeneratedProps =
	typeof generatedProps.file === "string" &&
	typeof generatedProps.isFallback === "boolean" &&
	Array.isArray(generatedProps.locales);
const pageProps = !isLocaleRoute
	? undefined
	: hasGeneratedProps
		? ({ ...generatedProps, locale } as Props)
		: createAboutProps(await getAboutFiles(), locale);
---

{
	pageProps ? (
		<Document>
			<SEO
				title={translate(Astro, "title.about_us")}
				description={translate(Astro, "desc.about_us")}
				providedLangs={pageProps.locales}
				noindex={pageProps.isFallback}
				slot="head"
			/>
			<AboutView
				locales={pageProps.locales}
				locale={pageProps.locale}
				file={pageProps.file}
			/>
		</Document>
	) : (
		<NotFoundPage />
	)
}
