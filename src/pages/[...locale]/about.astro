---
import Document from "#components/layouts/document/document.astro";
import SEO from "#components/seo/seo.astro";
import AboutView from "#src/views/about/about.astro";
import { isValidLocaleRouteParam } from "#utils/locales.ts";
import {
	createAboutProps,
	getAboutFiles,
	getAboutPaths,
	type AboutPageProps,
} from "#src/views/about/utils/route-data.ts";
import { getLocale, localizeHref } from "#src/paraglide/runtime.js";
import { m } from "#src/paraglide/messages.js";

export async function getStaticPaths() {
	return getAboutPaths();
}

const localeParam = Astro.params.locale;
if (!isValidLocaleRouteParam(localeParam)) {
	return Astro.rewrite(localizeHref("/404"));
}

const locale = getLocale();
const generatedProps = Astro.props as Partial<AboutPageProps>;
const hasGeneratedProps =
	typeof generatedProps.file === "string" &&
	typeof generatedProps.isFallback === "boolean" &&
	Array.isArray(generatedProps.locales);
const pageProps = hasGeneratedProps
	? (generatedProps as AboutPageProps)
	: createAboutProps(await getAboutFiles(), locale);

if (!pageProps) {
	return Astro.rewrite(localizeHref("/404"));
}
---

<Document>
	<SEO
		title={m.title_about_us()}
		description={m.desc_about_us()}
		providedLangs={pageProps.locales}
		noindex={pageProps.isFallback}
		slot="head"
	/>
	<AboutView locales={pageProps.locales} file={pageProps.file} />
</Document>
