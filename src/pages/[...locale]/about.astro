---
import * as fs from "fs/promises";
import Document from "#src/layouts/document.astro";
import SEO from "#components/seo/seo.astro";
import AboutView from "#src/views/about/about.astro";
import {
	getLanguageFromFilename,
	getStaticLocalePaths,
	translate,
} from "#utils/translations.ts";
import { join } from "path";
import { contentDirectory } from "#utils/data.ts";
import type { Languages } from "#types/index.ts";

export async function getStaticPaths() {
	const files = (await fs.readdir(join(contentDirectory, "site")))
		.filter((filename) => filename.startsWith("about-us"))
		.map((filename) => ({
			file: join(contentDirectory, "site", filename),
			locale: getLanguageFromFilename(filename),
		}));

	const englishFile = files.find(({ locale }) => locale === "en")!;

	return getStaticLocalePaths().map(({ params, props }) => {
		const data =
			files.find(({ locale }) => locale === props.locale) ?? englishFile;

		return {
			params,
			props: {
				file: data.file,
				isFallback: data.locale !== props.locale,
				locales: files.map((d) => d.locale),
				locale: props.locale,
			},
		};
	});
}

interface Props {
	file: string;
	isFallback: boolean;
	locales: Languages[];
	locale: Languages;
}

const { file, isFallback, locales, locale } = Astro.props as Props;
---

<Document>
	<SEO
		title={translate(Astro, "title.about_us")}
		description={translate(Astro, "desc.about_us")}
		providedLangs={locales}
		noindex={isFallback}
		slot="head"
	/>
	<AboutView locales={locales} locale={locale} file={file} />
</Document>
