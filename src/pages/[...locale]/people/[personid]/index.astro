---
import Document from "#components/layouts/document/document.astro";
import SEO from "#components/seo/seo.astro";
import PersonPage from "#src/views/person/person-page.astro";
import * as api from "#utils/api.ts";
import { isValidLocaleRouteParam } from "#utils/locales.ts";
import { baseLocale, getLocale, localizeHref } from "#src/paraglide/runtime.js";

export async function getStaticPaths() {
	return (await api.getAllPeople()).map((person) => ({
		params: {
			locale: person.locale === baseLocale ? undefined : person.locale,
			personid: person.id,
		},
	}));
}

const localeParam = Astro.params.locale;
if (!isValidLocaleRouteParam(localeParam)) {
	return Astro.rewrite(localizeHref("/404"));
}

const locale = getLocale();
const personId = Astro.params.personid;
const person = personId ? await api.getPersonById(personId, locale) : undefined;

if (!person || person.locale !== locale) {
	return Astro.rewrite(localizeHref("/404"));
}

const posts = await api.getPostsByPerson(person.id, locale);
---

<Document size="xl">
	<SEO
		slot="head"
		title={person.name}
		description={person.description}
		peopleData={[person]}
		providedLangs={person.locales}
		type="profile"
	/>
	<main class="listViewContent">
		<PersonPage person={person} posts={posts} />
	</main>
</Document>
