---
import Document from "#src/layouts/document.astro";
import SEO from "#components/seo/seo.astro";
import PersonPage from "#src/views/person/person-page.astro";
import NotFoundPage from "#src/views/not-found/not-found-page.astro";
import * as api from "#utils/api.ts";
import { isNonDefaultLanguageKey } from "#utils/translations.ts";
import FallbackWarning from "#src/views/base/fallback-warning/fallback-warning.astro";

export function getStaticPaths() {
	return api.getAllPeople().map((person) => ({
		params: {
			locale: person.locale === "en" ? undefined : person.locale,
			personid: person.id,
		},
	}));
}

const localeParam = Astro.params.locale;
const isLocaleRoute =
	localeParam === undefined || isNonDefaultLanguageKey(localeParam);
const locale = isNonDefaultLanguageKey(localeParam) ? localeParam : "en";
const personId = Astro.params.personid!;
const person = isLocaleRoute ? api.getPersonById(personId, locale) : undefined;

if (!person) {
	Astro.response.status = 404;
}

const isFallback = person ? person.locale !== locale : false;
const posts = person ? api.getPostsByPerson(person.id, locale) : [];
---

{
	person ? (
		<Document size="xl">
			<SEO
				slot="head"
				title={person.name}
				description={person.description}
				peopleData={[person]}
				providedLangs={person.locales}
				type="profile"
				noindex={isFallback}
			/>
			<main class="listViewContent">
				{isFallback && (
					<div class="fallback-container">
						<FallbackWarning requestedLocale={locale} />
					</div>
				)}
				<PersonPage person={person} posts={posts} locale={locale} />
			</main>
		</Document>
	) : (
		<NotFoundPage />
	)
}

<style>
	.fallback-container {
		max-width: var(--max-width_m);
		margin: 0 auto;
		padding: var(--site-spacing) var(--site-spacing) 0;
	}
</style>
