---
import style from "#src/views/join-us/join-us.module.scss";
import Document from "#components/layouts/document/document.astro";
import GetInvolvedHeader from "#src/views/join-us/components/header/get-involved-header.astro";
import SEO from "#components/seo/seo.astro";
import WhyGetInvolved from "#src/views/join-us/components/why-get-involved/why-get-involved.astro";
import WelcomeToEveryone from "#src/views/join-us/components/welcome-to-everyone/welcome-to-everyone.astro";
import ReadyToLevelUp from "#src/views/join-us/components/ready-to-level-up/ready-to-level-up.astro";
import SupportUs from "#src/views/join-us/components/support-us/support-us.astro";
import ContributorsAndPartners from "#src/views/join-us/components/contributors-and-partners/contributors-and-partners.astro";
import Hr from "#src/views/join-us/components/hr.astro";
import {
	getStaticLocalePaths,
	isValidLocaleRouteParam,
} from "#utils/locales.ts";
import { m } from "#src/paraglide/messages.js";

export function getStaticPaths() {
	return getStaticLocalePaths();
}

const localeParam = Astro.params.locale;
if (!isValidLocaleRouteParam(localeParam)) {
	return Astro.rewrite("/404");
}

const providedLangs = getStaticLocalePaths().map(({ props }) => props.locale);
---

<Document>
	<SEO
		title={m.title_join_us()}
		description={m.desc_join_us()}
		providedLangs={providedLangs}
		slot="head"
	/>
	<GetInvolvedHeader />
	<WhyGetInvolved />
	<WelcomeToEveryone />
	<ReadyToLevelUp />
	<div class={style.container}>
		<Hr />
	</div>
	<SupportUs />
	<div class={style.container}>
		<Hr />
	</div>
	<ContributorsAndPartners />
</Document>
