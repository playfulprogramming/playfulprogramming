---
import EventsPage from "#src/views/events/events-page.tsx";
import Document from "#src/layouts/document.astro";
import SEO from "#components/seo/seo.astro";
import { events } from "#src/views/events/constants.ts";
import { getLatestEventBlockLocationMetadata } from "#src/views/events/get-latest-event-block-location-metadata.ts";
import type { LatestEventBlockLocationMetadataType } from "#src/views/events/components/event-cards/types.ts";
import {
	getStaticLocalePaths,
	isNonDefaultLanguageKey,
	translate,
} from "#utils/translations.ts";
export async function getStaticPaths() {
	const latestEventBlockLocationMetadata =
		await getLatestEventBlockLocationMetadata();

	return getStaticLocalePaths().map(({ params, props }) => ({
		params,
		props: { ...props, latestEventBlockLocationMetadata },
	}));
}

interface Props {
	latestEventBlockLocationMetadata?: LatestEventBlockLocationMetadataType;
}

const localeParam = Astro.params.locale;
if (localeParam !== undefined && !isNonDefaultLanguageKey(localeParam)) {
	return Astro.rewrite("/404");
}

const locale = localeParam ?? "en";
const providedLangs = getStaticLocalePaths().map(({ props }) => props.locale);
const generatedProps = Astro.props as Props;
const latestEventBlockLocationMetadata =
	generatedProps.latestEventBlockLocationMetadata ??
	(await getLatestEventBlockLocationMetadata());
---

<Document size="l">
	<SEO
		title={translate(Astro, "title.events")}
		description={translate(Astro, "desc.events")}
		providedLangs={providedLangs}
		slot="head"
	/>
	<main>
		<EventsPage
			client:load
			events={events}
			locale={locale}
			latestEventBlockLocationMetadata={latestEventBlockLocationMetadata}
		/>
	</main>
</Document>
