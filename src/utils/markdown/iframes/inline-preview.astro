---
export interface Props {
	src: string;
}
---

<iframe src={Astro.props.src} data-no-frame></iframe>

<script>
	import "./inline-preview-script.ts";
</script>

<style is:global>
	/* Matching color schemes keeps transparent iframe canvases transparent. */
	html.light iframe[data-no-frame][src^="/"]:not([src^="//"]) {
		color-scheme: light;
	}

	html.dark iframe[data-no-frame][src^="/"]:not([src^="//"]) {
		color-scheme: dark;
	}
</style>
