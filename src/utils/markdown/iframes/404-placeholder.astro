---
import {
	FourOFourEmbed,
	type FourOFourEmbedProps,
} from "#components/404-embed/404-embed.js";
import { getPrefixLanguageFromPath } from "#utils/translations.ts";

export type Props = Omit<FourOFourEmbedProps, "locale">;

const locale = getPrefixLanguageFromPath(Astro.url.pathname);
---

<FourOFourEmbed {...Astro.props} locale={locale} client:load />
