---
import type { IFramePlaceholderProps } from "#components/iframe-placeholder/iframe-placeholder.tsx";
import { IFramePlaceholder as PreactIFramePlaceholder } from "#components/iframe-placeholder/iframe-placeholder.tsx";
import { getPrefixLanguageFromPath } from "#utils/translations.ts";

export type Props = Omit<IFramePlaceholderProps, "locale">;

const locale = getPrefixLanguageFromPath(Astro.url.pathname);
---

<PreactIFramePlaceholder {...Astro.props} locale={locale} client:load />
