---
import type { XEmbedPlaceholderProps } from "#components/x-embed/x-embed.tsx";
import { XEmbedPlaceholder as PreactXPlaceholder } from "#components/x-embed/x-embed.tsx";
import { getPrefixLanguageFromPath } from "#utils/translations.ts";

export type Props = Omit<XEmbedPlaceholderProps, "locale">;

const locale = getPrefixLanguageFromPath(Astro.url.pathname);
---

<PreactXPlaceholder {...Astro.props} locale={locale} client:load />
