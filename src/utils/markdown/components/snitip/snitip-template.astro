---
import type { SnitipInfo } from "#types/SnitipInfo.ts";
import { SnitipDialog } from "#components/snitip/snitip-dialog.tsx";
import "#src/views/base/scripts/snitip-trigger.scss";
import "#components/inline-popup/inline-popup.scss";

export interface Props {
	snitip: SnitipInfo;
	scopeId: string;
}

const { scopeId, snitip } = Astro.props;
const supportId = `${scopeId}-${snitip.id}`;
---

<SnitipDialog
	id={`snitip-dialog-${supportId}`}
	snitip={snitip}
	headingTag="h2"
/>

<script>
	import "#src/views/base/scripts/snitip-script-impl.ts";
</script>
