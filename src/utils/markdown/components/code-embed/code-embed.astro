---
import type { CodeEmbedProps } from "./code-embed.tsx";
import { CodeEmbed as PreactCodeEmbed } from "./code-embed.tsx";
import { getPrefixLanguageFromPath } from "#utils/translations.ts";

export type Props = Omit<CodeEmbedProps, "locale">;

const locale = getPrefixLanguageFromPath(Astro.url.pathname);
---

<PreactCodeEmbed client:visible {...Astro.props} locale={locale} />
