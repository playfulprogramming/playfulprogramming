---
import style from "./ready-to-level-up.module.scss";
import { Button } from "#components/index.ts";
import { translate } from "#utils/translations.ts";
---

<section class={style.container}>
	<h2 class={`text-style-headline-1 ${style.header}`}>
		{translate(Astro, "join_us.ready.title")}
	</h2>
	<div class={style.typesContainer}>
		<section class={style.typeContainer}>
			<div class={style.badgesContainer}>
				<img class={style.sticker} src="/stickers/role_author.svg" alt="" />
				<img class={style.sticker} src="/stickers/role_community.svg" alt="" />
				<img class={style.sticker} src="/stickers/role_translator.svg" alt="" />
			</div>
			<h3 class={`text-style-headline-3 ${style.typeTitle}`}>
				{translate(Astro, "join_us.publish.title")}
			</h3>
			<p class={`text-style-body-large ${style.typeBody}`}>
				{translate(Astro, "join_us.publish.description")}
			</p>
			<Button
				tag="a"
				href="https://github.com/playfulprogramming/playfulprogramming/blob/main/CONTRIBUTING.md#writing-a-new-post"
				>{translate(Astro, "action.submit_article")}</Button
			>
		</section>
		<section class={style.typeContainer}>
			<div class={style.badgesContainer}>
				<img class={style.sticker} src="/stickers/role_devops.svg" alt="" />
				<img class={style.sticker} src="/stickers/role_developer.svg" alt="" />
				<img class={style.sticker} src="/stickers/role_designer.svg" alt="" />
			</div>
			<h3 class={`text-style-headline-3 ${style.typeTitle}`}>
				{translate(Astro, "join_us.improve.title")}
			</h3>
			<p class={`text-style-body-large ${style.typeBody}`}>
				{translate(Astro, "join_us.improve.description")}
			</p>
			<Button
				tag="a"
				href="https://github.com/playfulprogramming/playfulprogramming"
				>{translate(Astro, "action.view_repository")}</Button
			>
		</section>
	</div>
</section>
