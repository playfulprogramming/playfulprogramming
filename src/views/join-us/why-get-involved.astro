---
import style from "./why-get-involved.module.scss";
import { translate } from "#utils/translations.ts";
---

<section>
	<h2 id="why-contribute" class={style.srOnly}>
		{translate(Astro, "join_us.why.title")}
	</h2>
	<ul class={style.illustrationList} aria-labelledby="why-contribute">
		<li class={style.illustrationListItem}>
			<!-- Replace with an `img` tag -->
			<div class={style.illustration}>
				<div
					class={style.illustrationImage}
					style="background-image: url('/illustrations/illustration-experience.svg')"
				>
				</div>
				<div class={style.illustrationBackground}></div>
			</div>
			<div class={style.illustrationTextContainer}>
				<p class={`text-style-headline-6 ${style.illustrationText}`}>
					{translate(Astro, "join_us.why.experience")}
				</p>
			</div>
		</li>

		<li class={style.illustrationListItem}>
			<div class={style.illustration}>
				<div
					class={style.illustrationImage}
					style="background-image: url('/illustrations/illustration-letter.svg')"
				>
				</div>
				<div class={style.illustrationBackground}></div>
			</div>
			<div class={style.illustrationTextContainer}>
				<p class={`text-style-headline-6 ${style.illustrationText}`}>
					{translate(Astro, "join_us.why.recommendation")}
				</p>
			</div>
		</li>

		<li class={style.illustrationListItem}>
			<div class={style.illustration}>
				<div
					class={style.illustrationImage}
					style="background-image: url('/illustrations/illustration-community.svg')"
				>
				</div>
				<div class={style.illustrationBackground}></div>
			</div>
			<div class={style.illustrationTextContainer}>
				<p class={`text-style-headline-6 ${style.illustrationText}`}>
					{translate(Astro, "join_us.why.community")}
				</p>
			</div>
		</li>
	</ul>
</section>
