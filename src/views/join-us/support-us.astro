---
import style from "./support-us.module.scss";
import { LargeButton } from "#components/button/button.tsx";

import * as data from "#utils/data.ts";
import { translate } from "#utils/translations.ts";
---

<section>
	<div class={style.supportUsTextContainer}>
		<h2 class={`text-style-headline-1 ${style.supportUsTitle}`}>
			{translate(Astro, "join_us.support.title")}
		</h2>
		<p class={`text-style-body-large ${style.supportUsBody}`}>
			{translate(Astro, "join_us.support.description_before_link")}
			{" "}
			<a
				href="https://github.com/playfulprogramming/playfulprogramming/issues?q=is%3Aissue+label%3Adisclosure+is%3Aclosed"
			>
				{translate(Astro, "action.disclosed_publicly")}</a
			>
		</p>
		<LargeButton
			tag="a"
			href="https://donate.playfulprogramming.com"
			variant="primary-emphasized"
			>{translate(Astro, "action.donate")}</LargeButton
		>
	</div>
	<div class={style.restContainer}>
		<h3
			id="our-sponsors"
			class={`text-style-body-large-bold ${style.supportedByBody}`}
		>
			{translate(Astro, "join_us.support.sponsors_intro")}
		</h3>
		<div>
			<ul
				class={style.sponsorsContainer}
				role="list"
				aria-labelledby="our-sponsors"
			>
				{
					Object.values(data.about.sponsors).map(({ name, logo, url }) => (
						<li class={style.sponsorItemContainer}>
							<a href={url} class={style.sponsorItem}>
								<img
									class={style.partnerImg}
									height="300"
									width="122"
									alt=""
									src={logo}
									loading="lazy"
								/>
								<span class={`text-style-body-large-bold ${style.sponsorName}`}>
									{name}
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
