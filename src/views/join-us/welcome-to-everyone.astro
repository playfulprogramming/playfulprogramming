---
import style from "./welcome-to-everyone.module.scss";
import { LargeButton } from "../../components/button/button.tsx";
import * as data from "../../utils/data.ts";
import { Icon } from "astro-icon/components";
import { m } from "#src/paraglide/messages.js";
---

<div class={style.container}>
	<section class={style.colorContainer}>
		<div class={style.textContainer}>
			<h2 class={`text-style-headline-4 ${style.title}`}>
				{m.join_us_welcome_title()}
			</h2>
			<p class={`text-style-body-large ${style.explainer}`}>
				{m.join_us_welcome_description()}
			</p>
		</div>
		<div class={style.buttonContainer}>
			<LargeButton
				class={style.button}
				tag="a"
				variant="secondary-emphasized"
				href="https://discord.playfulprogramming.com"
			>
				<Icon
					slot="leftIcon"
					style="width: 100%; height: 100%;"
					name={data.about.links.Discord.icon as never}
				/>
				{m.action_join_discord()}
			</LargeButton>
		</div>
	</section>
</div>
