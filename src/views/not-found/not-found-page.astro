---
import PageCard from "#components/page-card/page-card.astro";
import sadUnicorn from "#src/assets/emotes/unicorn_sad.svg";
import { LargeButton } from "#components/index.ts";
import { getLocale, localizeHref } from "#src/paraglide/runtime.js";
import { m } from "#src/paraglide/messages.js";

const locale = getLocale();
---

<main class="missingMain">
	<PageCard
		imageSrc={sadUnicorn.src}
		imageAlt={m.alt_crying_unicorn()}
		title={m.title_not_found()}
		description={m.desc_not_found()}
		numberOfButtons={2}
	>
		<LargeButton
			href={localizeHref("/", { locale })}
			slot="button"
			variant="primary"
		>
			{m.action_go_back_home()}
		</LargeButton>
		<LargeButton
			href="https://discord.playfulprogramming.com"
			slot="second-button"
			variant="secondary"
		>
			{m.action_report_issue()}
		</LargeButton>
	</PageCard>
</main>

<style lang="scss">
	.missingMain {
		display: flex;
		padding: var(--site-spacing);
		justify-content: center;
	}
</style>
