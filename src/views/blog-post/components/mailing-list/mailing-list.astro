---
import { Input } from "#components/input/input.tsx";
import { LargeButton } from "#components/button/button.tsx";
import styles from "./mailing-list.module.scss";
import { m } from "#src/paraglide/messages.js";

export type Props = Record<string, never>;
---

<form
	action="https://app.convertkit.com/forms/1254394/subscriptions"
	method="post"
	class={styles.container}
>
	<h2 class={`text-style-headline-5 ${styles.title}`}>
		{m.mailing_list_title()}
	</h2>
	<p class={`text-style-body-medium ${styles.description}`}>
		{m.mailing_list_description()}
	</p>
	<Input
		label={m.label_first_name()}
		aria-label={m.label_your_first_name()}
		name="fields[first_name]"
		type="text"
		containerClass={styles.firstName}
	/>
	<Input
		label={m.label_email_address()}
		name="email_address"
		aria-label={m.label_your_email_address()}
		required={true}
		type="email"
		containerClass={styles.emailAddress}
	/>
	<LargeButton
		tag="button"
		type="submit"
		variant="primary-emphasized"
		data-element="submit"
		class={styles.button}
	>
		{m.action_subscribe()}
	</LargeButton>
</form>
