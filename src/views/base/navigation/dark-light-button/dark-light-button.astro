---
import { Icon } from "astro-icon/components";
import { Button, IconOnlyButton } from "#components/index.ts";
import { m } from "#src/paraglide/messages.js";

const props = Astro.props as {
	variant: "iconOnly" | "large";
	class?: string;
};
---

{
	props.variant === "iconOnly" ? (
		<IconOnlyButton
			tag="button"
			data-theme-toggle
			aria-pressed="false"
			aria-label={m.label_dark_mode()}
			class={props.class}
		>
			<Icon
				name="dark_mode"
				style="width: 100%; height: 100%;"
				data-theme-toggle-icon="dark"
			/>
			<Icon
				name="light_mode"
				style="width: 100%; height: 100%;"
				data-theme-toggle-icon="light"
				style="display: none;"
			/>
		</IconOnlyButton>
	) : (
		<Button
			tag="button"
			data-theme-toggle
			aria-pressed="false"
			aria-label={m.label_dark_mode()}
			class={props.class}
		>
			<Icon
				slot="leftIcon"
				name="dark_mode"
				style="width: 100%; height: 100%;"
				data-theme-toggle-icon="dark"
			/>
			<Icon
				slot="leftIcon"
				name="light_mode"
				style="width: 100%; height: 100%;"
				data-theme-toggle-icon="light"
				style="display: none;"
			/>
			{m.action_switch_theme()}
		</Button>
	)
}
<script>
	import { themeToggle } from "./theme-toggle.ts";
	themeToggle();
</script>
