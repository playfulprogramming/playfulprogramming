---
import { languages } from "#src/constants/index.ts";
import {
	addPrefixLanguageToPath,
	getPrefixLanguageFromPath,
	removePrefixLanguageFromPath,
	translate,
	getMissingI18nKeys,
} from "#utils/translations.ts";
import type { Languages } from "#types/index.ts";
import styles from "./locale-switcher.module.scss";

const currentLocale = getPrefixLanguageFromPath(Astro.url.pathname);
const path = removePrefixLanguageFromPath(Astro.url.pathname);

const sortedLocales = (Object.keys(languages) as Languages[]).sort((a, b) =>
	a === "en" ? -1 : b === "en" ? 1 : languages[a].localeCompare(languages[b]),
);
---

<details class={styles.localeSwitcher}>
	<summary
		class={styles.toggle}
		aria-label={translate(Astro, "label.switch_language")}
		title={translate(Astro, "label.switch_language")}
	>
		<svg
			aria-hidden="true"
			xmlns="http://www.w3.org/2000/svg"
			width="24"
			height="24"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<circle cx="12" cy="12" r="10"></circle>
			<line x1="2" y1="12" x2="22" y2="12"></line>
			<path
				d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
			></path>
		</svg>
	</summary>
	<ul class={styles.dropdown} role="list">
		{
			sortedLocales.map((locale) => {
				const href = addPrefixLanguageToPath(path, locale);
				const isCurrent = locale === currentLocale;
				const missingKeys = getMissingI18nKeys(locale);
				const hasMissingKeys = missingKeys.length > 0;

				return (
					<li>
						<a
							href={href}
							aria-current={isCurrent ? "page" : undefined}
							class={isCurrent ? styles.current : undefined}
						>
							{languages[locale]}
							{hasMissingKeys && (
								<span
									class={styles.missingBadge}
									title={translate(Astro, "label.missing_translations")}
								>
									!
								</span>
							)}
						</a>
					</li>
				);
			})
		}
	</ul>
</details>
