---
import { Icon } from "astro-icon/components";
import { IconOnlyButton } from "#components/index.ts";
import { translate } from "#utils/translations.ts";

const { class: className } = Astro.props as { class?: string };
---

<IconOnlyButton tag="button" id="randomizebtn" class={`${className}`}>
	<Icon style="width: 100%; height: 100%;" name="dice" />
</IconOnlyButton>

<script>
	import { randomizeButtonListener } from "./randomize-button.ts";
	randomizeButtonListener();
</script>
