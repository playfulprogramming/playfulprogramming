---
import { Icon } from "astro-icon/components";
import { Button, IconOnlyButton } from "#components/index.ts";
import StyledSelect from "#components/styled-select/styled-select.astro";
import { THEME_FONT, THEME_FONT_FAMILIES } from "#src/constants/theme.ts";
import { m } from "#src/paraglide/messages.js";
import styles from "./theme-sidebar.module.scss";

const openDyslexicFont = {
	id: THEME_FONT.OpenDyslexic,
	label: "OpenDyslexic",
	family: THEME_FONT_FAMILIES[THEME_FONT.OpenDyslexic],
} as const;

const robotoMonoFont = {
	id: THEME_FONT.RobotoMono,
	label: "Roboto Mono",
	family: THEME_FONT_FAMILIES[THEME_FONT.RobotoMono],
} as const;

const headingFonts = [
	{
		id: THEME_FONT.Figtree,
		label: "Figtree",
		family: THEME_FONT_FAMILIES[THEME_FONT.Figtree],
	},
	{
		id: THEME_FONT.PlusJakartaSans,
		label: "Plus Jakarta Sans",
		family: THEME_FONT_FAMILIES[THEME_FONT.PlusJakartaSans],
	},
	{
		id: THEME_FONT.PlaypenSans,
		label: "Playpen Sans",
		family: THEME_FONT_FAMILIES[THEME_FONT.PlaypenSans],
	},
	openDyslexicFont,
	robotoMonoFont,
] as const;

const bodyFonts = [
	headingFonts[0],
	headingFonts[1],
	headingFonts[2],
	openDyslexicFont,
	robotoMonoFont,
	{
		id: THEME_FONT.System,
		label: "System UI",
		family: THEME_FONT_FAMILIES[THEME_FONT.System],
	},
] as const;

const colorModes = [
	{ icon: "light_mode", label: m.label_light(), mode: "light" },
	{ icon: "dark_mode", label: m.label_dark(), mode: "dark" },
	{ icon: "laptop", label: m.label_system(), mode: "system" },
] as const;

const contrastModes = [
	{ icon: "add", label: m.label_more(), mode: "more" },
	{ icon: "subtract", label: m.label_less(), mode: "less" },
	{ icon: "laptop", label: m.label_system(), mode: "system" },
] as const;

const colorOptions = Array.from({ length: 12 });
---

<dialog
	id="theme-sidebar"
	class={styles.dialog}
	aria-labelledby="theme-sidebar-title"
	data-theme-sidebar
>
	<form class={styles.form} method="dialog" data-theme-sidebar-form>
		<div class={styles.header}>
			<IconOnlyButton
				tag="button"
				type="button"
				aria-label={m.action_close_theme_customizer()}
				data-theme-sidebar-close
			>
				<Icon name="close" />
			</IconOnlyButton>
			<h2
				id="theme-sidebar-title"
				class={`text-style-headline-6 ${styles.title}`}
			>
				{m.action_customize_theme()}
			</h2>
		</div>

		<div class={styles.content}>
			<fieldset class={styles.section}>
				<legend class={styles.sectionTitle}>
					{m.label_theme()}
				</legend>
				<div class={styles.modeOptions}>
					{
						colorModes.map(({ icon, label, mode }) => (
							<>
								<input
									class={styles.choiceInput}
									type="radio"
									id={`theme-mode-${mode}`}
									name="theme-mode"
									value={mode}
									data-theme-mode
								/>
								<label
									class="button text-style-button-regular regular primary"
									for={`theme-mode-${mode}`}
								>
									{icon && (
										<span class="buttonIcon" aria-hidden="true">
											<Icon name={icon} />
										</span>
									)}
									<span class="innerText">{label}</span>
								</label>
							</>
						))
					}
				</div>
			</fieldset>

			<fieldset class={styles.section}>
				<legend class={styles.sectionTitle}>
					{m.label_contrast()}
				</legend>
				<div class={styles.modeOptions}>
					{
						contrastModes.map(({ icon, label, mode }) => (
							<>
								<input
									class={styles.choiceInput}
									type="radio"
									id={`theme-contrast-${mode}`}
									name="theme-contrast"
									value={mode}
									data-theme-contrast
								/>
								<label
									class="button text-style-button-regular regular primary"
									for={`theme-contrast-${mode}`}
								>
									<span class="buttonIcon" aria-hidden="true">
										<Icon name={icon} />
									</span>
									<span class="innerText">{label}</span>
								</label>
							</>
						))
					}
				</div>
			</fieldset>

			<fieldset class={styles.section}>
				<legend class={styles.sectionTitle}>
					{m.label_font()}
				</legend>
				<div class={styles.fontOptions}>
					<div class={styles.fontRow}>
						<label class={styles.controlLabel} for="theme-heading-font">
							{m.label_headings()}
						</label>
						<StyledSelect
							class={styles.fontSelect}
							id="theme-heading-font"
							data-theme-font="brand"
						>
							{
								headingFonts.map((font) => (
									<option
										value={font.id}
										data-font-family={font.family}
										style={`--styled-select_option-font-family: ${font.family}`}
									>
										{font.label}
									</option>
								))
							}
						</StyledSelect>
					</div>

					<div class={styles.fontRow}>
						<label class={styles.controlLabel} for="theme-body-font">
							{m.label_body()}
						</label>
						<StyledSelect
							class={styles.fontSelect}
							id="theme-body-font"
							data-theme-font="body"
						>
							{
								bodyFonts.map((font) => (
									<option
										value={font.id}
										data-font-family={font.family}
										style={`--styled-select_option-font-family: ${font.family}`}
									>
										{font.label}
									</option>
								))
							}
						</StyledSelect>
					</div>
				</div>
			</fieldset>

			<fieldset class={styles.section}>
				<legend class={styles.sectionTitle}>
					{m.label_color()}
				</legend>
				<div class={styles.colorOptions}>
					<fieldset class={styles.paletteGroup} data-theme-palette="primary">
						<legend class={styles.controlLabel}>
							{m.label_primary()}
						</legend>
						<div class={styles.palette}>
							{
								colorOptions.map((_, index) => (
									<span class={styles.swatchOption}>
										<input
											class={styles.choiceInput}
											type="radio"
											id={`theme-primary-color-${index}`}
											name="theme-primary-color"
											value={String(index * 30)}
											aria-label={m.label_primary_color_option({
												number: String(index + 1),
											})}
											data-theme-color-option
										/>
										<label
											class={styles.swatch}
											for={`theme-primary-color-${index}`}
											style={`--swatch-hue: ${index * 30}`}
										/>
									</span>
								))
							}
						</div>
					</fieldset>

					<fieldset class={styles.paletteGroup} data-theme-palette="secondary">
						<legend class={styles.controlLabel}>
							{m.label_secondary()}
						</legend>
						<div class={styles.palette}>
							{
								colorOptions.map((_, index) => (
									<span class={styles.swatchOption}>
										<input
											class={styles.choiceInput}
											type="radio"
											id={`theme-secondary-color-${index}`}
											name="theme-secondary-color"
											value={String(index * 30)}
											aria-label={m.label_secondary_color_option({
												number: String(index + 1),
											})}
											data-theme-color-option
										/>
										<label
											class={styles.swatch}
											for={`theme-secondary-color-${index}`}
											style={`--swatch-hue: ${index * 30}`}
										/>
									</span>
								))
							}
						</div>
					</fieldset>

					<div class={styles.surpriseGroup}>
						<p class={styles.controlLabel}>
							{m.label_surprise_me()}
						</p>
						<Button
							tag="button"
							type="button"
							class={styles.shuffleButton}
							data-theme-shuffle
						>
							<Icon slot="leftIcon" name="dice" />
							{m.action_shuffle()}
						</Button>
					</div>
				</div>
			</fieldset>
		</div>

		<div class={styles.footer}>
			<Button
				tag="button"
				type="submit"
				variant="primary-emphasized"
				data-theme-save
			>
				{m.action_save_changes()}
			</Button>
			<Button tag="button" type="button" variant="secondary" data-theme-reset>
				{m.action_reset()}
			</Button>
		</div>
	</form>
</dialog>

<script>
	import { initializeThemeSidebar } from "./theme-sidebar.ts";
	initializeThemeSidebar();
</script>
