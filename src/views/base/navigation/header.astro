---
import { Icon } from "astro-icon/components";
import * as data from "#utils/data.ts";
import { Button, IconOnlyButton } from "#components/index.ts";
import DarkLightButton from "./dark-light-button/dark-light-button.astro";
import BackButton from "./back-button/back-button.astro";
import style from "./header.module.scss";
import logo from "#src/assets/playfulprogramming_sticker.svg?url";
import {
	addPrefixLanguageToPath,
	getPrefixLanguageFromPath,
	removePrefixLanguageFromPath,
	translate,
} from "#utils/translations.ts";
import { SearchInput } from "#components/input/input.tsx";
import { SEARCH_QUERY_KEY } from "#src/views/search/search.ts";
import { siteMetadata } from "#src/constants/site-config.ts";

const path = removePrefixLanguageFromPath(Astro.url.pathname);
const locale = getPrefixLanguageFromPath(Astro.url.pathname);
const isHome = path === "/" || path === "";
const isAbout = /^\/about\/?/.test(path);
const isJoinUs = /^\/join-us\/?/.test(path);
const isSearch = /^\/search\/?/.test(path);
// Only match the specific events page
const isEvents = /^\/events\/?$/.test(path);
const [brandFirstWord, ...brandRemainingWords] = siteMetadata.title.split(" ");
const homeHref = addPrefixLanguageToPath("/", locale);
const aboutHref = addPrefixLanguageToPath("/about", locale);
const joinUsHref = addPrefixLanguageToPath("/join-us", locale);
const eventsHref = addPrefixLanguageToPath("/events", locale);
const searchHref = addPrefixLanguageToPath("/search", locale);

export type Props = {
	size?: "l" | "xl";
	disableDiscord?: boolean;
};

const props = Astro.props;
---

<header>
	<div id="header-bar" class={style.headerBorder} data-sticky-observer>
		<nav
			class={`${style.header} ${
				props.size === "xl" ? style.header_xl : ""
			} d-flex`}
		>
			{!isHome && <BackButton class={style.backButton} />}

			<a href={homeHref} class={`d-flex ${style.logo}`}>
				<img
					src={logo}
					width={56}
					height={56}
					alt={translate(Astro, "alt.playfulprogramming_logo")}
				/>

				<span class="text-style-button-regular">
					{brandFirstWord}
					{
						brandRemainingWords.length ? (
							<>
								<br />
								{brandRemainingWords.join(" ")}
							</>
						) : null
					}
				</span>
			</a>

			<div class={`d-flex ${style.nav}`}>
				{
					!isAbout && (
						<Button href={aboutHref} variant="primary">
							{translate(Astro, "title.about_us")}
						</Button>
					)
				}
				{
					!isJoinUs && (
						<Button href={joinUsHref} variant="primary">
							{translate(Astro, "title.join_us")}
						</Button>
					)
				}
				{
					!isEvents && (
						<Button href={eventsHref} variant="primary">
							{translate(Astro, "title.events")}
						</Button>
					)
				}
			</div>

			<div class={`d-flex ${style.icons}`}>
				{
					!isSearch && [
						<form method="get" action={searchHref} class={style.searchLarge}>
							<SearchInput
								name={SEARCH_QUERY_KEY}
								variant="dense"
								locale={locale}
							/>
						</form>,

						<IconOnlyButton
							href={searchHref}
							aria-label={translate(Astro, "title.search")}
							class={style.searchSmall}
						>
							<Icon style="width: 100%; height: 100%;" name="search" />
						</IconOnlyButton>,
					]
				}

				{
					!isHome &&
						!props.disableDiscord && [
							<Button
								href={data.about.links.Discord.url}
								aria-label={translate(Astro, "action.join_discord")}
								class={style.discordLarge}
							>
								<Icon
									slot="leftIcon"
									style="width: 100%; height: 100%;"
									name={data.about.links.Discord.icon as never}
								/>
								{translate(Astro, "action.join_discord")}
							</Button>,

							<IconOnlyButton
								href={data.about.links.Discord.url}
								aria-label={translate(Astro, "action.join_discord")}
								class={style.discordSmall}
							>
								<Icon
									style="width: 100%; height: 100%;"
									name={data.about.links.Discord.icon as never}
								/>
							</IconOnlyButton>,
						]
				}

				{
					isHome ? (
						<DarkLightButton variant="large" class={style.themeToggleLarge} />
					) : undefined
				}
				<DarkLightButton variant="iconOnly" class={style.themeToggleSmall} />
			</div>
		</nav>
	</div>
</header>
