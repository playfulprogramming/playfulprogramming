---
import { Icon } from "astro-icon/components";
import * as data from "#utils/data.ts";
import { Button, IconOnlyButton } from "#components/index.ts";
import DarkLightButton from "./dark-light-button/dark-light-button.astro";
import BackButton from "./back-button/back-button.astro";
import style from "./header.module.scss";
import logo from "#src/assets/playfulprogramming_sticker.svg?raw";
import { m } from "#src/paraglide/messages.js";
import { deLocalizeHref } from "#src/paraglide/runtime.js";
import { SearchInput } from "#components/input/input.tsx";
import { SEARCH_QUERY_KEY } from "#src/views/search/search.ts";

const path = deLocalizeHref(Astro.url.pathname);
const isHome = path === "/";
const isAbout = /^\/about\/?/.test(path);
const isJoinUs = /^\/join-us\/?/.test(path);
const isSearch = /^\/search\/?/.test(path);
// Only match the specific events page
const isEvents = /^\/events\/?$/.test(path);

export type Props = {
	size?: "l" | "xl";
	disableDiscord?: boolean;
};

const props = Astro.props;
---

<header>
	<div id="header-bar" class={style.headerBorder} data-sticky-observer>
		<nav
			class={`${style.header} ${
				props.size === "xl" ? style.header_xl : ""
			} d-flex`}
		>
			{!isHome && <BackButton class={style.backButton} />}

			<a
				href="/"
				aria-label={m.alt_playfulprogramming_logo()}
				class={`d-flex ${style.logo}`}
			>
				<div aria-hidden="true" set:html={logo} class={style.logoContainer} />

				<span class="text-style-button-regular">
					Playful<br />
					Programming
				</span>
			</a>

			<div class={`d-flex ${style.nav}`}>
				{
					!isAbout && (
						<Button href="/about" variant="text">
							{m.title_about_us()}
						</Button>
					)
				}
				{
					!isJoinUs && (
						<Button href="/join-us" variant="text">
							{m.title_join_us()}
						</Button>
					)
				}
				{
					!isEvents && (
						<Button href="/events" variant="text">
							{m.title_events()}
						</Button>
					)
				}
			</div>

			<div class={`d-flex ${style.icons}`}>
				{
					!isSearch && [
						<form method="get" action="/search" class={style.searchLarge}>
							<SearchInput name={SEARCH_QUERY_KEY} variant="dense" />
						</form>,

						<IconOnlyButton
							href="/search"
							aria-label={m.title_search()}
							class={style.searchSmall}
						>
							<Icon style="width: 100%; height: 100%;" name="search" />
						</IconOnlyButton>,
					]
				}

				{
					!isHome &&
						!props.disableDiscord && [
							<Button
								href={data.about.links.Discord.url}
								aria-label={m.action_join_discord()}
								class={style.discordLarge}
							>
								<Icon
									slot="leftIcon"
									style="width: 100%; height: 100%;"
									name={data.about.links.Discord.icon as never}
								/>
								{m.action_join_discord()}
							</Button>,

							<IconOnlyButton
								href={data.about.links.Discord.url}
								aria-label={m.action_join_discord()}
								class={style.discordSmall}
							>
								<Icon
									style="width: 100%; height: 100%;"
									name={data.about.links.Discord.icon as never}
								/>
							</IconOnlyButton>,
						]
				}

				{
					isHome ? (
						<DarkLightButton variant="large" class={style.themeToggleLarge} />
					) : undefined
				}
				<DarkLightButton variant="iconOnly" class={style.themeToggleSmall} />
			</div>
		</nav>
	</div>
</header>
