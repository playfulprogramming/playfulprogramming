---
import { Icon } from "astro-icon/components";
import { IconOnlyButton } from "#components/index.ts";
import {
	addPrefixLanguageToPath,
	getPrefixLanguageFromPath,
	translate,
} from "#utils/translations.ts";

const { class: className } = Astro.props as { class?: string };
const homeHref = addPrefixLanguageToPath(
	"/",
	getPrefixLanguageFromPath(Astro.url.pathname),
);
---

<IconOnlyButton
	tag="button"
	id="backbtn"
	data-home-href={homeHref}
	class={`${className}`}
	aria-label={translate(Astro, "action.go_back")}
>
	<Icon style="width: 100%; height: 100%;" name="arrow_left" />
</IconOnlyButton>

<script>
	import { backButtonListener } from "./back-button.ts";
	backButtonListener();
</script>
