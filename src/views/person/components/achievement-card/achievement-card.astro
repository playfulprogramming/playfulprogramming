---
import styles from "./achievement-card.module.scss";
import type { Achievement } from "#utils/achievements";

interface Props {
	achievement: Achievement;
}

const { achievement } = Astro.props;
---

<div class={styles.container}>
	<h3 class={`text-style-body-medium-bold ${styles.name}`}>
		{achievement.name}
	</h3>
	<p class={`text-style-body-small ${styles.description}`}>
		{achievement.body}
	</p>
</div>
