---
import styles from "./achievements.module.scss";
import type { AchievementsInfo } from "#types/AchievementsInfo.ts";

interface Props {
	achievement: AchievementsInfo;
}

const { achievement } = Astro.props;
---

<div class={styles.container}>
	<h3 class={`text-style-body-medium-bold ${styles.name}`}>
		{achievement.name}
	</h3>
	<p class={`text-style-body-small ${styles.description}`}>
		{achievement.body}
	</p>
</div>
