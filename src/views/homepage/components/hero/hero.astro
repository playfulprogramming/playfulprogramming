---
import BannerStickersGroup from "#components/banner-stickers/banner-stickers-group.astro";
import BowtieButton from "#components/bowtie-button/bowtie-button.astro";
import { LargeButton } from "#components/button/button.tsx";
import { Icon } from "astro-icon/components";
import style from "./hero.module.scss";
import { getLocale, localizeHref } from "#src/paraglide/runtime.js";
import { m } from "#src/paraglide/messages.js";
import * as data from "#utils/data.ts";

const locale = getLocale();
---

<section class={`${style.header}`}>
	<BannerStickersGroup class={style.bannerLogo} />
	<div class="text-center">
		<h1 class={`text-style-headline-2 ${style.title}`}>
			{m.desc_homepage()}
		</h1>
		<p class={`text-style-body-large-bold ${style.desc}`}>
			{m.desc_homepage_extra()}
		</p>
		<div class={style.buttons}>
			<BowtieButton href={data.about.links.Discord.url}>
				<Icon
					slot="leftIcon"
					style="width: 100%; height: 100%;"
					name={data.about.links.Discord.icon as never}
				/>
				{m.action_join_discord()}
			</BowtieButton>
			<LargeButton variant="primary" href={localizeHref("/about", { locale })}>
				{m.action_learn_more()}
				<Icon
					slot="rightIcon"
					style="width: 100%; height: 100%;"
					name="arrow_right"
				/>
			</LargeButton>
		</div>
	</div>
</section>
