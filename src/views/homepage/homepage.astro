---
import { PostCardGrid } from "#src/components/post-card/post-card-grid.tsx";
import { Button } from "#components/button/button.tsx";
import type { PostInfo, CollectionInfo } from "#types/index.ts";
import { CollectionCard } from "#components/collection-card/collection-card.tsx";
import { SubHeader } from "../../components/subheader/subheader.tsx";
import Hero from "../../components/hero/hero.astro";
import SearchSection from "../../components/search-section/search-section.astro";
import styles from "./homepage.module.scss";
import { buildSearchQuery } from "#src/views/search/utils/index.ts";
import * as api from "#utils/api.ts";
import { isDefined } from "#utils/is-defined.ts";
import { m } from "#src/paraglide/messages.js";
import { getLocale, localizeHref } from "#src/paraglide/runtime.js";

export interface Props {
	posts: PostInfo[];
	collections: CollectionInfo[];
}

const { posts, collections } = Astro.props;
const locale = getLocale();

const postAuthors = new Map(
	[...new Set(posts.flatMap((p) => p.authors))]
		.map((id) => api.getPersonById(id, locale))
		.filter(isDefined)
		.map((u) => [u.id, u]),
);
---

<Hero />
<section>
	<SubHeader tag="h2" text={m.title_recent_articles()} id="posts-header">
		<Button
			href={localizeHref(
				`/search?${buildSearchQuery({ searchQuery: "*", display: "articles" })}`,
				{ locale },
			)}
			aria-labelledby="posts-header"
		>
			{m.action_view_all()}
		</Button>
	</SubHeader>

	<PostCardGrid
		aria-labelledby="posts-header"
		postsToDisplay={posts}
		postAuthors={postAuthors}
		postHeadingTag="h3"
	/>
</section>

<section>
	<SubHeader tag="h2" text={m.title_collections()} id="collections-header">
		<Button
			href={localizeHref(
				`/search?${buildSearchQuery({
					searchQuery: "*",
					display: "collections",
				})}`,
				{ locale },
			)}
			aria-labelledby="collections-header"
		>
			{m.action_view_all()}
		</Button>
	</SubHeader>

	<ul
		role="list"
		aria-labelledby="collections-header"
		class={styles.collectionsGrid}
	>
		{
			collections.map((collection) => (
				<CollectionCard
					collection={collection}
					authors={collection.authors
						.map((id) => api.getPersonById(id, collection.locale))
						.filter(isDefined)}
					headingTag="h3"
				/>
			))
		}
	</ul>
</section>

<SearchSection />
