---
import BookCoverContainer from "../book-cover-container.astro";
import BookCoverLayer from "../book-cover-layer.astro";
import { BearCenter } from "#src/views/collection-framework-field-guide/components/book-cover/internals/bear_center.tsx";
import { CloudsFirstLayer } from "#src/views/collection-framework-field-guide/components/book-cover/internals/clouds_first_layer.tsx";
import { CloudsFourthLayer } from "#src/views/collection-framework-field-guide/components/book-cover/internals/clouds_fourth_layer.tsx";
import { CloudsSecondLayer } from "#src/views/collection-framework-field-guide/components/book-cover/internals/clouds_second_layer.tsx";
import { CloudsThirdLayer } from "#src/views/collection-framework-field-guide/components/book-cover/internals/clouds_third_layer.tsx";
import { GroundRepeat } from "#src/views/collection-framework-field-guide/components/book-cover/internals/ground_repeat.tsx";
import SafeArea from "#src/views/collection-framework-field-guide/components/book-cover/internals/safe-area.astro";
import { Trees } from "#src/views/collection-framework-field-guide/components/book-cover/internals/trees.tsx";
---

<style is:global>
	.internals-cover .background-repeat-layer {
		grid-template-columns: 1fr auto 1fr !important;
	}

	.internals-cover {
		background-color: var(--inter-900) !important;
	}
</style>

<BookCoverContainer class="internals-cover">
	<BookCoverLayer moveOnScrollBy={0.24} name="clouds-fourth-layer">
		<div slot="left"></div>
		<div slot="center" style="height: 100%; width: 100vw !important">
			<CloudsFourthLayer client:load />
		</div>
		<div slot="right"></div>
	</BookCoverLayer>
	<BookCoverLayer moveOnScrollBy={0.26} name="clouds-third-layer">
		<div slot="left"></div>
		<div slot="center" style="height: 100%; width: 100vw !important">
			<CloudsThirdLayer client:load />
		</div>
		<div slot="right"></div>
	</BookCoverLayer>
	<BookCoverLayer moveOnScrollBy={0.18} name="clouds-second-layer">
		<div slot="left"></div>
		<div slot="center" style="height: 100%; width: 100vw !important">
			<CloudsSecondLayer client:load />
		</div>
		<div slot="right"></div>
	</BookCoverLayer>
	<BookCoverLayer moveOnScrollBy={0.12} name="clouds-first-layer">
		<div slot="left"></div>
		<div slot="center" style="height: 100%; width: 100vw !important">
			<CloudsFirstLayer client:load />
		</div>
		<div slot="right"></div>
	</BookCoverLayer>
	<BookCoverLayer moveOnScrollBy={0.04} name="trees-internals">
		<div slot="left"></div>
		<div slot="center" style="height: 100%; width: 100vw !important">
			<Trees client:load />
		</div>
		<div slot="right"></div>
	</BookCoverLayer>
	<BookCoverLayer name="ground">
		<div slot="left"></div>
		<div slot="center" style="height: 100%; width: 100vw !important">
			<GroundRepeat client:load />
		</div>
		<div slot="right"></div>
	</BookCoverLayer>
	<BookCoverLayer name="left-repeat" class="safe-area-internals">
		<div slot="left"></div>
		<div
			slot="center"
			style="max-width: min(var(--max-width_small),100vw,100vh); width: 100vw;"
		>
			<SafeArea />
		</div>
		<div slot="right"></div>
	</BookCoverLayer>
	<BookCoverLayer name="bear">
		<div slot="left"></div>
		<div slot="center">
			<BearCenter />
		</div>
		<div slot="right"></div>
	</BookCoverLayer>
</BookCoverContainer>
