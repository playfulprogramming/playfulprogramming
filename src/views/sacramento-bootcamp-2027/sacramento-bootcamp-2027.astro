---
import Title from "./components/title/title.astro";
import style from "./sacramento-bootcamp.module.scss";
import edit from "#src/assets/icons/edit.svg?raw";
import authors from "#src/assets/icons/authors.svg?raw";
import discussion from "#src/assets/icons/discussion.svg?raw";
import notebook from "#src/assets/icons/notebook.svg?raw";
import warning from "#src/assets/icons/warning.svg?raw";
import date from "#src/assets/icons/date.svg?raw";
import location from "#src/assets/icons/location.svg?raw";
import { LargeButton } from "#components/index.ts";
import * as data from "#utils/data.ts";
import { Icon } from "astro-icon/components";
let submissionsClosed = false;
// let submissionsClosed =
// 	"Our class is full, and we’re grateful for the overwhelming response!";
---

<div class={style.contain}>
	<p class={`text-style-headline-4 ${style.invitedText}`}>
		You’re invited to our second annual bootcamp!
	</p>

	<Title />
</div>

<div class={style.mainCardContainer}>
	<div class={style.outcomeAndWhatWhereContainer}>
		<div class={style.outcomesContainer}>
			<div class={style.welcomeContainer}>
				<h2 class={`text-style-headline-2 ${style.welcomeText}`}>
					Welcome to Playful Programming’s second annual bootcamp!
				</h2>
				<p class={`text-style-body-large`}>
					We are excited to propose a free 16-week Web Development Bootcamp,
					beginning in January 2027. Our mission is to empower adult learners
					with the fundamentals of modern frontend web development, including
					HTML, CSS, JavaScript, and React. The course is designed to provide
					both technical knowledge and hands-on practice, ensuring participants
					can confidently apply their skills beyond the classroom.
				</p>
			</div>
			<div class={style.outcomesApplyAndSponsorsContainer}>
				<div class={style.outcomesAndApplyContainer}>
					<div class={style.outcomesListContainer}>
						<h2 class={`text-style-headline-4 ${style.outcomeTitle}`}>
							Outcomes
						</h2>
						<ul class={style.outcomeList}>
							<li class={`text-style-body-small-bold ${style.outcomeListItem}`}>
								<span class={style.outcomeIcon} set:html={edit} /> Build front-end
								applications
							</li>
							<li class={`text-style-body-small-bold ${style.outcomeListItem}`}>
								<span class={style.outcomeIcon} set:html={authors} />
								Pursue entry-level roles such as Front-end Developer, Web Developer,
								or UI Developer.
							</li>
							<li class={`text-style-body-small-bold ${style.outcomeListItem}`}>
								<span class={style.outcomeIcon} set:html={discussion} />
								Contribute to real-world development teams
							</li>
							<li class={`text-style-body-small-bold ${style.outcomeListItem}`}>
								<span class={style.outcomeIcon} set:html={notebook} /> Continue your
								education
							</li>
						</ul>
					</div>

					<div class={style.applyContainer}>
						{
							!submissionsClosed ? (
								<div class={style.applyContainer}>
									<LargeButton
										tag="a"
										href="https://forms.gle/FQ9A7Up5hJyUmTng7"
										variant="secondary-emphasized"
										class={style.applyBtn}
									>
										Apply to join
									</LargeButton>
									<span class={style.eighteenWarningContainer}>
										<span set:html={warning} class={style.warningIcon} />
										You must be 18 or older to participate.
									</span>
								</div>
							) : (
								<div>
									<p
										class={
											"text-style-headline-6" + " " + style.classIsFullText
										}
									>
										{submissionsClosed}
									</p>
									<p class="text-style-headline-8">
										Join our Discord to stay connected for future cohorts!
									</p>
									<div class={style.buttonContainer}>
										<LargeButton
											class={style.eventActionBtn}
											tag="a"
											variant="primary-emphasized"
											href="https://discord.playfulprogramming.com"
										>
											<Icon
												slot="leftIcon"
												style="width: 100%; height: 100%;"
												name={data.about.links.Discord.icon as never}
											/>
											Join our Discord
										</LargeButton>
									</div>
								</div>
							)
						}
					</div>
				</div>
				<!-- <div class={style.sponsorsContainer}>
					<p class={`text-style-headline-6 ${style.partnersTitle}`}>
						Partners:
					</p>
					<div class={style.sponsorContainer}>
						<a
							href="https://bikedogbrewing.com/"
							target="_blank"
							rel="noopener noreferrer sponsored"
							><img
								class={style.sponsor}
								src="/sponsors/bikedog.png"
								alt="Bike Dog Brewing"
							/></a
						>
					</div>
				</div> -->
			</div>
		</div>
		<div class={style.whenWhereContainer}>
			<div class={style.whenContainer}>
				<span class={style.whenTitleContainer}>
					<span class={style.whenIcon} set:html={date} />
					<h2 class={`text-style-headline-6`}>When?</h2>
				</span>
				<div class={style.whenDescriptionContainer}>
					<p class="text-style-body-small">
						Our bootcamp will be held in January 2027.
						<br />
						<br />
						It’s a 16-week bootcamp, 2 days a week, Tuesday / Thursday. 1 hour each,
						6-7 PM
						<br />
						<br />
						This means you’ll have plenty of time to prepare.
					</p>
				</div>
			</div>
			<div class={style.whereContainer}>
				<span class={style.whereTitleContainer}>
					<span class={style.whereIcon} set:html={location} />
					<h2 class={`text-style-headline-6`}>Where?</h2>
				</span>
				<div class={style.whereDescriptionContainer}>
					<p class="text-style-body-small">
						Our bootcamp will be hosted in-person in <a href="https://www.google.com/maps/place/Sacramento,+CA" target="_blank" rel="nofollow noopener noreferrer">Sacramento, California</a>.
						<br />
						<br />
						Due to the limited slots, please make sure to secure your spot early. We'll get in touch with the venue location when your registration is confirmed.
					</p>
				</div>
			</div>
		</div>
	</div>
	<h2 class="visually-hidden" id="pfp-boot-modules">Modules</h2>
	<ol
		class={style.modulesContainer}
		aria-labelledby="pfp-boot-modules"
		role="list"
	>
		<li class={style.moduleListItem}>
			<div class={style.headingContainer}>
				<h3 class={`text-style-headline-4`}>Module 1: HTML & CSS</h3>
				<span class={`text-style-headline-6 ${style.weekTitle}`}>2 weeks</span>
			</div>
			<ul class={style.moduleItemList} role="list">
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Course introduction & overview
				</li>
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Introduction to HTML & CSS
				</li>
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Elements, Attributes, Colors, Fonts and Spacing
				</li>
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Build a simple webpage
				</li>
			</ul>
		</li>
		<li class={style.moduleListItem}>
			<div class={style.headingContainer}>
				<h3 class={`text-style-headline-4`}>Module 2: JavaScript</h3>
				<span class={`text-style-headline-6 ${style.weekTitle}`}>3 weeks</span>
			</div>
			<ul class={style.moduleItemList} role="list">
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Introduction to JavaScript
				</li>
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Variables and data types
				</li>
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Functions
				</li>
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Working with the DOM and adding interactivity to web pages
				</li>
			</ul>
		</li>
		<li class={style.moduleListItem}>
			<div class={style.headingContainer}>
				<h3 class={`text-style-headline-4`}>Module 3: React</h3>
				<span class={`text-style-headline-6 ${style.weekTitle}`}>7 weeks</span>
			</div>
			<ul class={style.moduleItemList} role="list">
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Introduction to Components
				</li>
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Props and State
				</li>
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Side Effects
				</li>
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Error Handling
				</li>
			</ul>
		</li>
		<li class={style.moduleListItem}>
			<div class={style.headingContainer}>
				<h3 class={`text-style-headline-4`}>Module 4: Projects</h3>
				<span class={`text-style-headline-6 ${style.weekTitle}`}>4 weeks</span>
			</div>
			<ul class={style.moduleItemList} role="list">
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Build a complete project
				</li>
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Work on a team project
				</li>
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Project presentation
				</li>
				<li class={`text-style-body-medium-bold ${style.moduleItemListItem}`}>
					Final project submission
				</li>
			</ul>
		</li>
	</ol>
</div>
