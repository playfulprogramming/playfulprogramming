---
import { Chip } from "../chip/chip.tsx";
import { getLocale, localizeHref } from "#src/paraglide/runtime.js";
import { m } from "#src/paraglide/messages.js";
import style from "./search-section.module.scss";
import * as data from "#utils/data.ts";
import { SearchInput } from "../input/input.tsx";
import { IconOnlyButton } from "../button/button.tsx";
import { Icon } from "astro-icon/components";
import {
	SEARCH_QUERY_KEY,
	buildSearchQuery,
} from "#src/views/search/utils/index.ts";

const tagsToDisplay = [...data.tags.entries()]
	.sort(() => 0.5 - Math.random())
	.slice(0, 8);
const locale = getLocale();
const searchPath = localizeHref("/search", { locale });
---

<section class={style.container}>
	<h2 class={`text-style-headline-4 ${style.title}`}>
		{m.title_looking_for_more()}
	</h2>
	<p class={`text-style-body-medium ${style.description}`}>
		{m.desc_looking_for_more()}
	</p>

	<form class={style.searchbarRow} method="get" action={searchPath}>
		<SearchInput name={SEARCH_QUERY_KEY} class={style.searchbar} />
		<IconOnlyButton
			tag="button"
			type="submit"
			class={style.searchButton}
			aria-label={m.title_search()}
		>
			<Icon style="width: 100%; height: 100%;" name="arrow_right" />
		</IconOnlyButton>
	</form>

	<ul
		class="unlist-inline gap-2 text-center"
		aria-label={m.label_post_tags()}
		role="list"
	>
		{
			tagsToDisplay.map((tag) => (
				<li>
					<Chip
						href={`${searchPath}?${buildSearchQuery({
							searchQuery: "*",
							filterTags: [tag[0]],
						})}`}
					>
						{tag[1].displayName}
					</Chip>
				</li>
			))
		}
	</ul>
</section>
