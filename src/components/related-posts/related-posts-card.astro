---
import style from "./related-posts-card.module.scss";
import { getHrefContainerProps } from "#utils/href-container-script.ts";
import type { PersonInfo } from "../../types/PersonInfo.ts";

import { localizeHref } from "#src/paraglide/runtime.js";

interface Props {
	title: string;
	href: string;
	authors: PersonInfo[];
}

const { title, href, authors } = Astro.props;
---

<li {...getHrefContainerProps(href)} class={style.container}>
	<a href={href} class={`text-style-body-medium-bold ${style.articleTitle}`}
		>{title}
	</a>

	<span class={`text-style-body-small-bold ${style.authorsList}`}>
		{
			authors.map((author, i) => (
				<a
					href={localizeHref(`/people/${author.id}`, {
						locale: author.locale,
					})}
					class={style.authorName}
				>
					{[author.name, i + 1 < authors.length ? "," : ""]}
				</a>
			))
		}
	</span>
</li>
