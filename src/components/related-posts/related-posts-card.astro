---
import style from "./related-posts-card.module.scss";
import { getHrefContainerProps } from "#utils/href-container-script.ts";
import type { PersonInfo } from "../../types/PersonInfo.ts";
import type { Languages } from "#types/index.ts";
import { addPrefixLanguageToPath } from "#utils/translations.ts";

interface RelatedPostsCardProps {
	title: string;
	slug: string;
	authors: PersonInfo[];
	locale: Languages;
}

const { title, slug, authors, locale } = Astro.props as RelatedPostsCardProps;
const postHref = addPrefixLanguageToPath(`/posts/${slug}`, locale);
---

<li {...getHrefContainerProps(postHref)} class={style.container}>
	<a href={postHref} class={`text-style-body-medium-bold ${style.articleTitle}`}
		>{title}
	</a>

	<span class={`text-style-body-small-bold ${style.authorsList}`}>
		{
			authors.map((author, i) => (
				<a
					href={addPrefixLanguageToPath(`/people/${author.id}`, author.locale)}
					class={style.authorName}
				>
					{[author.name, i + 1 < authors.length ? "," : ""]}
				</a>
			))
		}
	</span>
</li>
