---
import { Icon } from "astro-icon/components";
import { IconOnlyButton } from "#src/components/index.ts";
import { getLocale, localizeHref } from "#src/paraglide/runtime.js";
import { m } from "#src/paraglide/messages.js";

const { class: className } = Astro.props as { class?: string };
const homeHref = localizeHref("/", { locale: getLocale() });
---

<IconOnlyButton
	tag="button"
	id="backbtn"
	data-home-href={homeHref}
	class={`${className}`}
	aria-label={m.action_go_back()}
>
	<Icon style="width: 100%; height: 100%;" name="arrow_left" />
</IconOnlyButton>

<script>
	import { backButtonListener } from "./back-button.ts";
	backButtonListener();
</script>
