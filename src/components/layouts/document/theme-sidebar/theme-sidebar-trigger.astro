---
import { Icon } from "astro-icon/components";
import { IconOnlyButton } from "#src/components/index.ts";
import { m } from "#src/paraglide/messages.js";
import styles from "./theme-sidebar.module.scss";
---

<IconOnlyButton
	tag="button"
	type="button"
	aria-controls="theme-sidebar"
	aria-expanded="false"
	aria-haspopup="dialog"
	aria-label={m.action_customize_theme()}
	data-theme-sidebar-trigger="true"
>
	<span class={styles.triggerIcon} data-theme-sidebar-trigger-icon="dark">
		<Icon name="paintbrush" />
	</span>
	<span
		class={styles.triggerIcon}
		data-theme-sidebar-trigger-icon="light"
		hidden
	>
		<Icon name="light_mode" />
	</span>
</IconOnlyButton>
