---
import { Input } from "../input/input.tsx";
import { LargeButton } from "../button/button.tsx";
import styles from "./mailing-list.module.scss";
import { translate } from "#utils/translations.ts";
---

<form
	action="https://app.convertkit.com/forms/1254394/subscriptions"
	method="post"
	class={styles.container}
>
	<h2 class={`text-style-headline-5 ${styles.title}`}>
		{translate(Astro, "mailing_list.title")}
	</h2>
	<p class={`text-style-body-medium ${styles.description}`}>
		{translate(Astro, "mailing_list.description")}
	</p>
	<Input
		label={translate(Astro, "label.first_name")}
		aria-label={translate(Astro, "label.your_first_name")}
		name="fields[first_name]"
		type="text"
		containerClass={styles.firstName}
	/>
	<Input
		label={translate(Astro, "label.email_address")}
		name="email_address"
		aria-label={translate(Astro, "label.your_email_address")}
		required={true}
		type="email"
		containerClass={styles.emailAddress}
	/>
	<LargeButton
		tag="button"
		type="submit"
		variant="primary-emphasized"
		data-element="submit"
		class={styles.button}
	>
		{translate(Astro, "action.subscribe")}
	</LargeButton>
</form>
