---
import style from "./contributor-card.module.scss";
import type { PersonInfo } from "../../types/index.ts";
import { Picture } from "../image/picture.tsx";
import { Button } from "../index.ts";
import { localizeHref } from "#src/paraglide/runtime.js";
import { m } from "#src/paraglide/messages.js";
import { getHrefContainerProps } from "../../utils/href-container-script.ts";
import allRoles from "../../../content/data/roles.json" with { type: "json" };
import { tabletSmall } from "../../constants/breakpoints.ts";

interface Props {
	person: PersonInfo;
	overrides?: {
		roles?: string[];
		isPartner?: boolean;
	};
}

const { person, overrides } = Astro.props;
const personHref = localizeHref(`/people/${person.id}`, {
	locale: person.locale,
});

const roles =
	overrides?.roles === undefined
		? person.roles.map(
				(role) => allRoles.find((r) => r.id === role)!.prettyname,
			)
		: overrides.roles;

const isPartner =
	overrides?.isPartner === undefined
		? person.achievements.includes("partner")
		: overrides.isPartner;
---

<li class={style.card} {...getHrefContainerProps(personHref)}>
	<Picture
		alt=""
		width={96}
		height={96}
		sizes={{
			80: { maxWidth: tabletSmall },
		}}
		imgAttrs={{
			class: style.avatar,
			"data-dont-round": "true",
		}}
		src={person.profileImgMeta.relativeServerPath}
	/>

	<div class={style.info}>
		<span class={`${style.name} text-style-body-large-bold`}>
			{person.name}
			{
				isPartner && (
					<span class={`text-style-body-small-bold ${style.partnerLabel}`}>
						<img width="16" height="16" src="/flair/bowtie.svg" alt="" />
						{m.label_partner()}
					</span>
				)
			}
		</span>
		<ul
			class={`${style.roles} text-style-body-small`}
			aria-label={m.desc_person_roles()}
			role="list"
		>
			{
				roles.map((role, i, arr) => (
					<li role="listitem">
						{[role, i < arr.length - 1 && <span aria-hidden="true">, </span>]}
					</li>
				))
			}
		</ul>
	</div>

	<Button
		class={style.button}
		href={personHref}
		aria-label={m.label_view_profile_for({ name: person.name })}
	>
		{m.action_view_profile()}
	</Button>
</li>
