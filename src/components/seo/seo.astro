---
import { siteMetadata, siteUrl } from "#src/constants/site-config.ts";
import { deLocalizeHref, getLocale } from "#src/paraglide/runtime.js";
import { m } from "#src/paraglide/messages.js";
import Article from "./article.astro";
import Book from "./book.astro";
import Locale from "./locale.astro";
import OpenGraph from "./open-graph.astro";
import Profile from "./profile.astro";
import type { SEOProps } from "./shared.ts";
import Twitter from "./twitter.astro";

export type Props = SEOProps;

const {
	description = "",
	title,
	keywords,
	canonical,
	type,
	peopleData,
	publishedTime,
	editedTime,
	isbn,
	providedLangs,
	shareImage,
	noindex,
} = Astro.props;

const lang = getLocale();
const pathName = deLocalizeHref(Astro.url.pathname);

const metaDescription = description || m.seo_default_description();
const metaKeywords = keywords ? keywords.join(",") : m.seo_default_keywords();
const metaImage = new URL(
	shareImage ?? "/share-banner.png",
	siteUrl,
).toString();

const ogType = type ?? "blog";

const socialPerson = peopleData?.find((uni) => uni.socials);
const uniTwitter =
	socialPerson && socialPerson.socials && socialPerson.socials.twitter;

const removeTrailingSlash = (str: string) =>
	str.endsWith("/") ? str.slice(0, -1) : str;

const currentPath = removeTrailingSlash(
	siteMetadata.siteUrl + (Astro.url.pathname || ""),
);
---

<title>
	{title ? `${title} | ${siteMetadata.title}` : siteMetadata.title}
</title>
<>
	{
		canonical ? (
			<link rel="canonical" href={canonical} />
		) : (
			<link rel="canonical" href={currentPath} />
		)
	}
</>
<meta property="name" content={siteMetadata.title} />
<meta name="description" content={metaDescription} />
<meta property="keywords" content={metaKeywords} />
<link
	rel="preload"
	href="/fonts/Figtree/Figtree-VariableFont_wght.ttf"
	as="font"
	type="font/ttf"
	crossorigin
/>

{
	// If the page is non-indexed, exclude it from any search results with the "robots" tag
	// https://developers.google.com/search/docs/crawling-indexing/block-indexing
	noindex ? <meta name="robots" content="noindex, nofollow" /> : null
}

<Twitter
	title={title}
	metaDescription={metaDescription}
	siteMetadata={siteMetadata}
	metaImage={metaImage}
	peopleData={peopleData}
	uniTwitter={uniTwitter}
	type={type}
/>
<OpenGraph
	currentPath={currentPath}
	siteMetadata={siteMetadata}
	title={title}
	lang={lang}
	providedLangs={providedLangs}
	metaDescription={metaDescription}
	metaImage={metaImage}
	ogType={ogType}
/>
<Locale
	providedLangs={providedLangs}
	siteMetadata={siteMetadata}
	pathName={pathName}
/>
<link
	rel="alternate"
	href={`${siteUrl}/atom.xml`}
	type="application/atom+xml"
	title={m.seo_atom_feed_title({ siteTitle: siteMetadata.title })}
/>
<link
	rel="alternate"
	href={`${siteUrl}/rss.xml`}
	type="application/rss+xml"
	title={m.seo_rss_feed_title({ siteTitle: siteMetadata.title })}
/>
<link
	rel="alternate"
	href={`${siteUrl}/feed.json`}
	type="application/json"
	title={m.seo_json_feed_title({ siteTitle: siteMetadata.title })}
/>
<>
	{
		type === "article" && (
			<Article
				keywords={keywords}
				editedTime={editedTime}
				publishedTime={publishedTime}
				peopleData={peopleData}
			/>
		)
	}
</>
<>
	{
		type === "book" && (
			<Book publishedTime={publishedTime} peopleData={peopleData} isbn={isbn} />
		)
	}
</>
<>
	{type === "profile" && <Profile peopleData={peopleData} />}
</>
<slot />
