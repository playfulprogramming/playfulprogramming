---
import {
	baseLocale,
	deLocalizeHref,
	localizeHref,
	type Locale,
} from "#src/paraglide/runtime.js";
import { localeToOpenGraph } from "#utils/locales.ts";

export type Props = {
	providedLangs?: Locale[];
	pathName: string;
	siteMetadata: { siteUrl: string };
};

const { providedLangs, siteMetadata, pathName } = Astro.props;

const removeTrailingSlash = (str: string) =>
	str.endsWith("/") ? str.slice(0, -1) : str;

const canonicalPath = deLocalizeHref(pathName || "");
const absoluteLocalizedUrl = (locale: Locale) =>
	removeTrailingSlash(
		new URL(localizeHref(canonicalPath, { locale }), siteMetadata.siteUrl).href,
	);
---

<link
	rel="alternate"
	href={absoluteLocalizedUrl(baseLocale)}
	hreflang="x-default"
/>
<>
	{
		providedLangs?.length
			? providedLangs.map((locale) => (
					<link
						rel="alternate"
						href={absoluteLocalizedUrl(locale)}
						hreflang={localeToOpenGraph(locale)}
					/>
				))
			: null
	}
</>
