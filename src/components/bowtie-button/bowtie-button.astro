---
import styles from "./bowtie-button.module.scss";

interface Props {
	className?: string;
	href?: string;
}

const { className, href } = Astro.props;
---

<a
	id="bowtie-button"
	class={`button large text-style-button-large ${styles.bowtieButton} ${className || ""}`}
	href={href}
>
	<div aria-hidden="true" class="buttonIcon">
		<slot name="leftIcon" />
	</div>
	<span class="innerText"><slot /></span>
	<div class={`${styles.bowtieVisibility}`}>
		<div data-bowtie class={`${styles.bowties}`}></div>
	</div>
	<div class={`${styles.staticBackground}`}></div>
</a>

<script src="./bowtie-button-script.ts"></script>
