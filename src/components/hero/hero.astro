---
import BannerStickersGroup from "../banner-stickers/banner-stickers-group.astro";
import BowtieButton from "../bowtie-button/bowtie-button.astro";
import { LargeButton } from "../button/button.tsx";
import { Icon } from "astro-icon/components";
import style from "./hero.module.scss";
import { m } from "#src/paraglide/messages.js";
import * as data from "#utils/data.ts";
---

<section class={`${style.header}`}>
	<BannerStickersGroup class={style.bannerLogo} />
	<div class="text-center">
		<h1 class={`text-style-headline-2 ${style.title}`}>
			{m["desc.homepage"]()}
		</h1>
		<p class={`text-style-body-large-bold ${style.desc}`}>
			{m["desc.homepage_extra"]()}
		</p>
		<div class={style.buttons}>
			<BowtieButton href={data.about.links.Discord.url}>
				<Icon
					slot="leftIcon"
					style="width: 100%; height: 100%;"
					name={data.about.links.Discord.icon as never}
				/>
				{m["action.join_discord"]()}
			</BowtieButton>
			<LargeButton variant="primary" href="/about">
				{m["action.learn_more"]()}
				<Icon
					slot="rightIcon"
					style="width: 100%; height: 100%;"
					name="arrow_right"
				/>
			</LargeButton>
		</div>
	</div>
</section>
